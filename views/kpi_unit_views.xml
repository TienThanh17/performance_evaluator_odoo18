<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_kpi_unit_list" model="ir.ui.view">
            <field name="name">hr.kpi.unit.list</field>
            <field name="model">hr.kpi.unit</field>
            <field name="arch" type="xml">
                <list string="KPI Units" editable="bottom">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_hr_kpi_unit_form" model="ir.ui.view">
            <field name="name">hr.kpi.unit.form</field>
            <field name="model">hr.kpi.unit</field>
            <field name="arch" type="xml">
                <form string="KPI Unit">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_hr_kpi_unit_search" model="ir.ui.view">
            <field name="name">hr.kpi.unit.search</field>
            <field name="model">hr.kpi.unit</field>
            <field name="arch" type="xml">
                <search string="KPI Units">
                    <field name="name"/>
                    <field name="code"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="action_hr_kpi_unit" model="ir.actions.act_window">
            <field name="name">KPI Units</field>
            <field name="res_model">hr.kpi.unit</field>
            <field name="view_mode">list</field>
        </record>

        <menuitem id="menu_hr_kpi_unit"
                  name="KPI Units"
                  parent="menu_performance_evaluator_config"
                  action="action_hr_kpi_unit"
                  sequence="5"/>
    </data>
</odoo>
