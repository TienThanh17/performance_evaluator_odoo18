<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_performance_evaluation_approve_all_wizard_form" model="ir.ui.view">
            <field name="name">performance.evaluation.approve.all.wizard.form</field>
            <field name="model">performance.evaluation.approve.all.wizard</field>
            <field name="arch" type="xml">
                <form string="Approve Department Evaluations">
                    <sheet>
                        <group>
                            <field name="department_id" readonly="1" />
                            <field name="dept_evaluation_id" readonly="1" />
                            <field name="evaluation_count" readonly="1" />
                            <field name="notify_user_ids" widget="many2many_tags"
                                options="{'no_create': True}" />
                        </group>

                        <field name="evaluation_ids" readonly="1" nolabel="1">
                            <list create="0" delete="0" edit="0">
                                <field name="name" string="Reference" />
                                <field name="employee_id" />
                                <field name="manager_id" />
                                <field name="state" />
                            </list>
                        </field>
                    </sheet>
                    <footer>
                        <button name="action_confirm" type="object" string="Approve All"
                            class="btn-primary" />
                        <button string="Cancel" special="cancel" class="btn-secondary" />
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
