<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Dedicated form view for KPI Line used in popup (Add KPI) -->
        <record id="view_hr_kpi_line_form_popup" model="ir.ui.view">
            <field name="name">hr.kpi.line.form.popup</field>
            <field name="model">hr.kpi.template.line</field>
            <field name="arch" type="xml">
                <form string="KPI Line">
                    <sheet>
                        <div class="oe_title">
                            <h2 class="mb-1">
                                <field name="key_performance_area"
                                    placeholder="Key Performance Area" />
                            </h2>
                        </div>

                        <field name="is_section" invisible="1" />
                        <field name="parent_dept_kpi_id" invisible="1" />

                        <group>
                            <group string="KPI Info">
                                <field name="kpi_id" invisible="1" />
                                <field name="pillar_id" options="{'no_create': True}" />
                                <field name="parent_line_id" options="{'no_create': True}" />
                                <field name="kpi_type" invisible="is_section" />
                                <field name="manual_scoring_type"
                                    invisible="is_section or kpi_type != 'manual'" />
                                <field name="unit"
                                    invisible="is_section or kpi_type != 'auto'" />
                                <field name="scoring_formula_id"
                                    invisible="is_section or kpi_type != 'auto'"
                                    options="{'no_create': True}" />
                                <field name="weight" readonly="is_section" />

                                <field name="wipeout_if_child_zero"
                                    invisible="not is_section" />
                            </group>
                            <group string="Auto Compute"
                                invisible="is_section or kpi_type != 'auto'">
                                <field name="is_auto" readonly="1"
                                    invisible="kpi_type != 'auto'" />
                                <field name="data_source_id" invisible="kpi_type != 'auto'" />
                            </group>
                        </group>

                        <group invisible="is_section">
                            <group string="Target"
                                invisible="kpi_type != 'auto' or is_special_scoring">
                                <field name="target" />
                            </group>
                        </group>

                        <group string="Description">
                            <field name="description" placeholder="KPI Description"
                                style="width: 100%; min-width: 400px;" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- list View for KPI (List View) -->
        <record id="view_hr_kpi_list" model="ir.ui.view">
            <field name="name">hr kpi</field>
            <field name="model">hr.kpi.template</field>
            <field name="arch" type="xml">
                <list>
                    <!--                    <header>-->
                    <!--                        <button
                    name="%(custom_adecsol_hr_performance_evaluator.action_hr_kpi_generate_wizard)d"-->
                    <!--                                type="action"-->
                    <!--                                string="Generate Evaluations"-->
                    <!--                                class="btn-primary"-->
                    <!--
                    groups="custom_adecsol_hr_performance_evaluator.group_hr,custom_adecsol_hr_performance_evaluator.group_manager"/>-->
                    <!--                    </header>-->
                    <field name="name" />
                    <field name="department_id" />
                    <field name="job_id" widget="many2many_tags" />
                    <field name="period_type" />
                </list>
            </field>
        </record>

        <!-- Shared list view for KPI Template Line (dùng chung cho P2.1, P2.2) -->
        <record id="view_hr_kpi_template_line_shared_list" model="ir.ui.view">
            <field name="name">hr.kpi.template.line.shared.list</field>
            <field name="model">hr.kpi.template.line</field>
            <field name="arch" type="xml">
                <list editable="bottom" decoration-bf="is_section">
                    <control>
                        <create name="add_section" string="Add Section"
                            context="{'default_is_section': True, 'default_display_type': 'line_section'}" />
                        <create name="add_kpi" string="Add KPI" />
                    </control>

                    <field name="sequence" widget="kpi_template_tree_handle" width="30px"
                        invisible="is_section" />

                    <field name="is_section" column_invisible="True" />
                    <field name="pillar_code" column_invisible="True" />
                    <field name="parent_dept_kpi_id" column_invisible="True" />

                    <field name="key_performance_area" string="Title" width="300px" />

                    <field name="description"
                        string="Info"
                        widget="kpi_description_icon"
                        invisible="is_section"
                        optional="show" width="100px" />

                    <field name="kpi_type" invisible="is_section" width="100px" />
                    <field name="manual_scoring_type"
                        invisible="is_section or kpi_type != 'manual'"
                        optional="show"
                        width="140px" />
                    <field name="unit"
                        string="Unit"
                        invisible="is_section or kpi_type != 'auto'"
                        optional="hide" width="80px" />

                    <field name="scoring_formula_id"
                        optional="hide"
                        invisible="is_section or kpi_type != 'auto'"
                        options="{'no_create': True}" width="200px" />

                    <field name="is_auto" column_invisible="1" />
                    <field name="data_source_id"
                        invisible="is_section or not is_auto"
                        optional="hide" width="150px" />

                    <field name="target" string="Target"
                        invisible="is_section or kpi_type != 'auto'"
                        optional="hide"
                        width="100px" />

                    <field name="weight" width="80px" readonly="is_section" />
                    <field name="wipeout_if_child_zero"
                        column_invisible="True" />
                    <field name="wipeout_if_child_zero"
                        string=""
                        widget="kpi_wipeout_warning_icon"
                        invisible="not is_section or not wipeout_if_child_zero"
                        optional="show" width="100px" />
                    <button name="action_open_popup" type="object"
                        icon="fa-pencil" title="Open Details"
                        width="40px" />
                </list>
            </field>
        </record>

        <!-- Form View for KPI -->
        <record id="view_hr_kpi_form" model="ir.ui.view">
            <field name="name">hr.kpi.form</field>
            <field name="model">hr.kpi.template</field>
            <field name="arch" type="xml">
                <form string="KPI">
                    <!-- <header>
                        <button
                            name="%(custom_adecsol_hr_performance_evaluator.action_hr_kpi_generate_wizard)d"
                            type="action"
                            string="Generate Evaluations"
                            class="btn-primary"
                    groups="custom_adecsol_hr_performance_evaluator.group_hr,custom_adecsol_hr_performance_evaluator.group_manager"
                            context="{'default_kpi_id': id, 'default_department_id': department_id}" />
                    </header> -->
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button"
                                type="object"
                                name="action_open_department_templates"
                                icon="fa-sitemap">
                                <field name="department_template_count"
                                    string="Department Templates"
                                    widget="statinfo" />
                            </button>
                        </div>
                        <!-- Use Odoo native grid to keep labels/fields aligned consistently -->
                        <group>
                            <group>
                                <field name="name" />
                                <field name="period_type" />
                            </group>
                            <group>
                                <field name="department_id" />
                                <field name="job_id" widget="many2many_tags" />
                                <!-- <field name="scoring_profile_id" /> -->
                                <!-- <field name="department_kpi_id" options="{'no_create': True}"/> -->
                            </group>
                        </group>

                        <notebook>
                            <page string="P2.1 Knowledge">
                                <!-- <h2 class="text-primary mt-2 mb-3">
                                    <field name="pillar_p2_1_name" readonly="1" nolabel="1" />
                                </h2> -->
                                <field name="kpi_line_p2_1_ids" widget="kpi_template_tree_one2many"
                                    context="{'form_view_ref': 'custom_adecsol_hr_performance_evaluator.view_hr_kpi_line_form_popup', 'title_field': 'key_performance_area', 'default_pillar_code': 'p2_1', 'list_view_ref': 'custom_adecsol_hr_performance_evaluator.view_hr_kpi_template_line_shared_list'}" />
                                <div
                                    class="o_perf_summary mt-3 d-flex justify-content-between align-items-start">
                                    <div
                                        class="o_perf_summary_body o_perf_summary_body_left flex-grow-1 pe-3">
                                        <div class="o_perf_summary_title">Scoring Formula</div>
                                        <div class="text-muted mt-2" style="font-size: 14px;">
                                            <strong>P2.1 Total</strong> = ∑ (Top-level P2.1 Line
                                            Score × Weight) / ∑ Weight<br />
                                            <span
                                                style="font-size: 14px; font-style: italic;">
                                                If the total top-level P2.1 weight is 0, the system
                                            falls back to the average of top-level P2.1 line scores.
                                            </span>

                                            <div
                                                class="mt-3">
                                                <details>
                                                    <summary
                                                        class="btn btn-sm btn-outline-info text-start"
                                                        style="cursor: pointer;">
                                                        <i class="fa fa-info-circle me-1" />
                                                        <strong>Line Scoring Guide</strong>
                                                    </summary>

                                                    <div
                                                        class="mt-2 p-3 border rounded bg-light text-dark">
                                                        <strong>- Manual KPI</strong><br /> Binary:
                                            Pass = 100 points, Fail = 0 points.<br /> Rating: 0 to 5
                                            stars, each star = 20 points.<br /> Score: enter the
                                            score directly into the score field.<br />
                        <br />
                        <strong>-
                                            Auto KPI</strong><br /> Score is calculated from <strong>
                                            Target</strong> and <strong>
                                                            Actual</strong> based on the selected <strong>Scoring
                                            Formula</strong>. If a data source is linked, the system
                                            can auto-fill <strong>Actual</strong> before applying
                                            the formula. </div>
                                                </details>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="o_perf_summary_body o_perf_summary_body_right">
                                        <div class="o_perf_summary_title">Total Weight</div>
                                        <div class="o_perf_summary_score">
                                            <span class="o_perf_label">P2.1 Total Weight</span>
                                            <span class="o_perf_value">
                                                <field name="total_weight_p2_1" />
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </page>
                            <page string="P2.2 Professional Skills">
                                <!-- <h2 class="text-primary mt-2 mb-3">
                                    <field name="pillar_p2_2_name" readonly="1" nolabel="1" />
                                </h2> -->
                                <field name="kpi_line_p2_2_ids" widget="kpi_template_tree_one2many"
                                    context="{'form_view_ref': 'custom_adecsol_hr_performance_evaluator.view_hr_kpi_line_form_popup', 'title_field': 'key_performance_area', 'default_pillar_code': 'p2_2', 'list_view_ref': 'custom_adecsol_hr_performance_evaluator.view_hr_kpi_template_line_shared_list'}" />
                                <div
                                    class="o_perf_summary mt-3 d-flex justify-content-between align-items-start">
                                    <div
                                        class="o_perf_summary_body o_perf_summary_body_left flex-grow-1 pe-3">
                                        <div class="o_perf_summary_title">Scoring Formula</div>
                                        <div class="text-muted mt-2" style="font-size: 14px;">
                                            <strong>P2.2 Total</strong> = ∑ (Top-level P2.2 Line
                                            Score × Weight) / ∑ Weight<br />
                                            <span
                                                style="font-size: 14px; font-style: italic;">
                                                If the total top-level P2.2 weight is 0, the system
                                            falls back to the average of top-level P2.2 line scores.
                                            </span>

                                            <div
                                                class="mt-3">
                                                <details>
                                                    <summary
                                                        class="btn btn-sm btn-outline-info text-start"
                                                        style="cursor: pointer;">
                                                        <i class="fa fa-info-circle me-1" />
                                                        <strong>Line Scoring Guide</strong>
                                                    </summary>

                                                    <div
                                                        class="mt-2 p-3 border rounded bg-light text-dark">
                                                        <strong>- Manual KPI</strong><br /> Binary:
                                            Pass = 100 points, Fail = 0 points.<br /> Rating: 0 to 5
                                            stars, each star = 20 points.<br /> Score: enter the
                                            score directly into the score field.<br />
                        <br />
                        <strong>-
                                            Auto KPI</strong><br /> Score is calculated from <strong>
                                            Target</strong> and <strong>
                                                            Actual</strong> based on the selected <strong>Scoring
                                            Formula</strong>. If a data source is linked, the system
                                            can auto-fill <strong>Actual</strong> before applying
                                            the formula. </div>
                                                </details>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="o_perf_summary_body o_perf_summary_body_right">
                                        <div class="o_perf_summary_title">Total Weight</div>
                                        <div class="o_perf_summary_score">
                                            <span class="o_perf_label">P2.2 Total Weight</span>
                                            <span class="o_perf_value">
                                                <field name="total_weight_p2_2" />
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </page>
                            <page string="P3.1.1 Individual KPI">
                                <!-- <h2 class="text-primary mt-2 mb-3">
                                    <field name="pillar_p3_ind_name" readonly="1" nolabel="1" />
                                </h2> -->
                                <field name="kpi_line_p3_individual_ids"
                                    widget="kpi_template_tree_one2many"
                                    context="{'form_view_ref': 'custom_adecsol_hr_performance_evaluator.view_hr_kpi_line_form_popup', 'title_field': 'key_performance_area', 'default_pillar_code': 'p3_individual'}">
                                    <list editable="bottom" decoration-bf="is_section">
                                        <field name="sequence" widget="kpi_template_tree_handle" invisible="is_section"/>
                                        <field name="is_section" column_invisible="True" />
                                        <field name="pillar_code" column_invisible="True" />

                                        <field name="parent_dept_kpi_id" column_invisible="True" />

                                        <field name="key_performance_area" string="Title"
                                            width="450px" />
                                        <field name="description"
                                            string="Info"
                                            widget="kpi_description_icon"
                                            invisible="is_section"
                                            optional="show" width="100px" />
                                        <!-- <field name="pillar_id" options="{'no_create': True}"
                                            width="150px" /> -->
                                        <!-- <field name="parent_line_id"
                                            domain="[('kpi_id', '=', parent.id), ('id', '!=', id)]"
                                            options="{'no_create': True}"
                                            invisible="is_section"
                                            optional="show" width="150px" /> -->


                                        <field name="kpi_type" invisible="is_section" width="100px" />
                                        <field name="manual_scoring_type"
                                            invisible="is_section or kpi_type != 'manual'"
                                            width="140px" optional="hide" />
                                        <field name="unit"
                                            string="Unit"
                                            invisible="is_section or kpi_type != 'auto'"
                                            optional="show" width="330px" />

                                        <field name="scoring_formula_id"
                                            invisible="is_section or kpi_type != 'auto'"
                                            options="{'no_create': True}" width="300px" />

                                        <field name="is_auto" column_invisible="1" />
                                        <field name="data_source_id"
                                            invisible="is_section or not is_auto" width="150px"
                                            optional="hide" />

                                        <field name="target" string="Target"
                                            invisible="is_section or kpi_type != 'auto'"
                                            width="100px" />

                                        <field name="weight" width="80px" readonly="is_section" />
                                        <field name="wipeout_if_child_zero"
                                            column_invisible="True" />
                                        <field name="wipeout_if_child_zero"
                                            string=""
                                            widget="kpi_wipeout_warning_icon"
                                            invisible="not is_section or not wipeout_if_child_zero"
                                            optional="show" width="100px" />
                                        <button name="action_open_popup" type="object"
                                            icon="fa-pencil" title="Open Details"
                                            width="40px" />
                                        <control>
                                            <create name="add_section" string="Add Section"
                                                context="{'default_is_section': True, 'default_display_type': 'line_section', 'default_pillar_code': 'p3_individual'}"
                                            />
                                            <create name="add_kpi" string="Add KPI"
                                                context="{'default_pillar_code': 'p3_individual'}" />
                                        </control>
                                    </list>
                                </field>
                                <div
                                    class="o_perf_summary mt-3 d-flex justify-content-between align-items-start">
                                    <div
                                        class="o_perf_summary_body o_perf_summary_body_left flex-grow-1 pe-3">
                                        <div class="o_perf_summary_title">Scoring Formula</div>
                                        <div class="text-muted mt-2" style="font-size: 14px;">
                                            <strong>Individual KPI Score</strong> = ∑ (Top-level
                                            P3.1.1 Line Score × Weight) / ∑ Weight<br />
                                            <span
                                                style="font-size: 14px; font-style: italic;">
                                                If the total top-level P3.1.1 weight is 0, the
                                                system falls back to the average of top-level P3.1.1
                                            line scores.
                                            </span>

                                            <div
                                                class="mt-3">
                                                <details>
                                                    <summary
                                                        class="btn btn-sm btn-outline-info text-start"
                                                        style="cursor: pointer;">
                                                        <i class="fa fa-info-circle me-1" />
                                                        <strong>Line Scoring Guide</strong>
                                                    </summary>

                                                    <div
                                                        class="mt-2 p-3 border rounded bg-light text-dark">
                                                        <strong>- Manual KPI</strong><br /> Binary:
                                            Pass = 100 points, Fail = 0 points.<br /> Rating: 0 to 5
                                            stars, each star = 20 points.<br /> Score: enter the
                                            score directly into the score field.<br />
                        <br />
                        <strong>-
                                            Auto KPI</strong><br /> Score is calculated from <strong>
                                            Target</strong> and <strong>
                                                            Actual</strong> based on the selected <strong>Scoring
                                            Formula</strong>. If a data source is linked, the system
                                            can auto-fill <strong>Actual</strong> before applying
                                            the formula. </div>
                                                </details>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="o_perf_summary_body o_perf_summary_body_right">
                                        <div class="o_perf_summary_title">Total Weight</div>
                                        <div class="o_perf_summary_score">
                                            <span class="o_perf_label">P3.1.1 Total Weight</span>
                                            <span class="o_perf_value">
                                                <field name="total_weight_p3_individual" />
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
