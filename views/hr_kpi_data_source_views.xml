<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_kpi_data_source_list" model="ir.ui.view">
        <field name="name">hr.kpi.data.source.list</field>
        <field name="model">hr.kpi.data.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" />
                <field name="source_type" />
                <field name="model_name" />
                <field name="aggregation" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="view_hr_kpi_data_source_form" model="ir.ui.view">
        <field name="name">hr.kpi.data.source.form</field>
        <field name="model">hr.kpi.data.source</field>
        <field name="arch" type="xml">
            <form string="Data Source">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Tên Nguồn Dữ Liệu" />
                        <h1>
                            <field name="name" placeholder="VD: Số ngày đi làm thực tế..." />
                        </h1>
                    </div>

                    <group>
                        <group name="basic_info" string="Thông tin chung">
                            <field name="code" />
                            <field name="unit_id" />
                            <field name="description" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                    </group>

                    <hr />
                    <group name="source_config" string="Logic Xử Lý">
                        <field name="source_type" widget="radio" options="{'horizontal': true}" />
                    </group>

                    <div class="alert alert-warning text-center mt-3" role="alert"
                        invisible="source_type != 'system'">
                        <strong><i class="fa fa-lock" /> Lưu ý:</strong> Nguồn dữ liệu này được tính
                        toán tự động bởi hệ thống và không thể chỉnh sửa logic để đảm
                        bảo tính chính xác. </div>

                    <group invisible="source_type != 'domain'">
                        <group>
                            <field name="model_id" required="source_type == 'domain'" />
                            <field name="model_name" invisible="1" />
                            <field name="user_field_id" options="{'no_create': True}"
                                invisible="not model_id" />
                            <field name="date_field_id" options="{'no_create': True}"
                                invisible="not model_id" />
                        </group>
                        <group>
                            <field name="aggregation" required="source_type == 'domain'" />
                            <field name="sum_avg_field_id"
                                options="{'no_create': True}"
                                invisible="aggregation not in ('sum', 'avg')"
                                required="aggregation in ('sum', 'avg')" />
                        </group>
                        <group colspan="2">
                            <field name="domain_numerator" widget="domain"
                                options="{'model': 'model_name'}" />
                            <field name="domain_denominator" widget="domain"
                                options="{'model': 'model_name'}" invisible="aggregation != 'ratio'" />
                        </group>
                    </group>

                    <group invisible="source_type != 'python'">
                        <field name="python_code" widget="ace" options="{'mode': 'python'}"
                            nolabel="1" colspan="2" />
                    </group>

                </sheet>
                <footer>
                    <button name="action_test_execute" type="object" string="Chạy thử"
                        class="btn-primary" icon="fa-play" />
                    <button string="Đóng" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_kpi_data_source" model="ir.actions.act_window">
        <field name="name">Data Sources</field>
        <field name="res_model">hr.kpi.data.source</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_kpi_data_source" name="Data Sources" parent="menu_kpi_configuration"
        action="action_hr_kpi_data_source" sequence="30" />
</odoo>
