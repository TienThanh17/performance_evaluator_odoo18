<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_evaluation_pillar_list" model="ir.ui.view">
        <field name="name">hr.evaluation.pillar.list</field>
        <field name="model">hr.evaluation.pillar</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_evaluation_pillar_form" model="ir.ui.view">
        <field name="name">hr.evaluation.pillar.form</field>
        <field name="model">hr.evaluation.pillar</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
