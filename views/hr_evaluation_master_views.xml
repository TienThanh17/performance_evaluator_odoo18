<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_evaluation_pillar_list" model="ir.ui.view">
        <field name="name">hr.evaluation.pillar.list</field>
        <field name="model">hr.evaluation.pillar</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_evaluation_pillar_form" model="ir.ui.view">
        <field name="name">hr.evaluation.pillar.form</field>
        <field name="model">hr.evaluation.pillar</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Categories">
                            <field name="category_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_evaluation_category_list" model="ir.ui.view">
        <field name="name">hr.evaluation.category.list</field>
        <field name="model">hr.evaluation.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="pillar_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_evaluation_category_form" model="ir.ui.view">
        <field name="name">hr.evaluation.category.form</field>
        <field name="model">hr.evaluation.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="pillar_id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_evaluation_pillar" model="ir.actions.act_window">
        <field name="name">Evaluation Pillars</field>
        <field name="res_model">hr.evaluation.pillar</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_hr_evaluation_category" model="ir.actions.act_window">
        <field name="name">Evaluation Categories</field>
        <field name="res_model">hr.evaluation.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_evaluation_pillar"
              name="Evaluation Pillars"
              parent="menu_kpi_configuration"
              action="action_hr_evaluation_pillar"
              sequence="45"/>

    <menuitem id="menu_hr_evaluation_category"
              name="Evaluation Categories"
              parent="menu_kpi_configuration"
              action="action_hr_evaluation_category"
              sequence="46"/>
</odoo>
