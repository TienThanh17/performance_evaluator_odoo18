<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form_inherit_kpi_thresholds" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.kpi.thresholds</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app string="Performance Evaluation"
                        name="custom_adecsol_hr_performance_evaluator"
                        logo="/custom_adecsol_hr_performance_evaluator/static/description/icon.png">

                        <block title="Scoring &amp; Evaluation Rules">
                            <setting string="KPI thresholds "
                                help="Define score thresholds to classify evaluation results.">
                                <div class="row mt16 o_settings_container">
                                    <div>
                                        <label for="kpi_threshold_excellent" />
                                        <div class="text-muted">Score ≥ this value is considered <b>
                                            Excellent</b>. </div>
                                        <field name="kpi_threshold_excellent" class="w-100" />
                                    </div>
                                    <div class="mt-3">
                                        <label for="kpi_threshold_pass" />
                                        <div class="text-muted">Score ≥ this value (and &lt;
                                            Excellent) is considered <b>Pass</b>. </div>
                                        <field name="kpi_threshold_pass" class="w-100" />
                                    </div>
                                </div>
                                <div class="text-muted">
                                    Example: Excellent ≥ 90 and Pass ≥ 50 on the fixed 100-point KPI
                                    scale (based on the criteria in section P3.1).
                                </div>
                            </setting>

                            <setting string="P3.1 Weight"
                                help="Define how P3.1.1 and P3.1.2 contribute to the 3P summary total.">
                                <div class="row mt16 o_settings_container">
                                    <div>
                                        <label for="p3_individual_weight_percent" />
                                        <div class="text-muted">Weight used for the <b>P3.1.1</b>
                                            individual KPI score.</div>
                                        <field name="p3_individual_weight_percent" class="w-100" />
                                    </div>
                                    <div class="mt-3">
                                        <label for="p3_department_weight_percent" />
                                        <div class="text-muted">Weight used for the <b>P3.1.2</b>
                                            department KPI score.</div>
                                        <field name="p3_department_weight_percent" class="w-100" />
                                    </div>
                                </div>
                                <div class="text-muted mt-3">
                                    Note: P3.1.1 and P3.1.2 weights must total exactly 100%.
                                </div>
                                <div class="text-muted mt-2">
                                    <b>P3.1 Coefficient Rule:</b> The final coefficient is
                                    determined by the total achieved weight (Sum of P3.1.1 and
                                    P3.1.2): <ul class="mb-0 pl-4">
                                        <li>Total Weight ≥ 100% → Coefficient: 1.0</li>
                                        <li>Total Weight ≥ 90% → Coefficient: 0.8</li>
                                        <li>Total Weight ≥ 80% → Coefficient: 0.7</li>
                                        <li>Total Weight ≥ 70% → Coefficient: 0.5</li>
                                        <li>Total Weight &lt; 70% → Coefficient: 0.0</li>
                                    </ul>
                                </div>
                            </setting>

                            <setting string="Evaluation Report Deadline Reminder"
                                help="Set the number of days before the deadline to notify employees.">
                                <field name="deadline_reminder_days" />
                            </setting>
                        </block>

                        <block title="KPI Settings">
                            <setting string="Attendance Grace Period"
                                help="Configure the tolerance for late arrivals.">
                                <field name="late_grace_minutes" />
                            </setting>
                        </block>

                    </app>
                </xpath>
            </field>
        </record>

    </data>
</odoo>