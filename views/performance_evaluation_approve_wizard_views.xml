<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_performance_evaluation_approve_wizard_form" model="ir.ui.view">
            <field name="name">performance.evaluation.approve.wizard.form</field>
            <field name="model">performance.evaluation.approve.wizard</field>
            <field name="arch" type="xml">
                <form string="Approve Evaluation">
                    <sheet>
                        <group>
                            <field name="evaluation_id" readonly="1" />
                            <field name="notify_user_ids" widget="many2many_tags"
                                options="{'no_create': True}" />
                        </group>

                        <notebook>
                            <page string="Notification Message">
                                <field string="message" name="notification_message" widget="html"
                                    nolabel="1" />
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button name="action_confirm" type="object" string="Approve"
                            class="btn-primary" />
                        <button string="Cancel" special="cancel" class="btn-secondary" />
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>