<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_kpi_dashboard_widget_list" model="ir.ui.view">
        <field name="name">hr.kpi.dashboard.widget.list</field>
        <field name="model">hr.kpi.dashboard.widget</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="dashboard_kind"/>
                <field name="widget_type"/>
                <field name="scope"/>
                <field name="measure_field"/>
                <field name="sequence"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_kpi_dashboard_widget_form" model="ir.ui.view">
        <field name="name">hr.kpi.dashboard.widget.form</field>
        <field name="model">hr.kpi.dashboard.widget</field>
        <field name="arch" type="xml">
            <form string="Dashboard Widget">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="dashboard_kind"/>
                        <field name="widget_type"/>
                        <field name="scope"/>
                        <field name="measure_field"/>
                        <field name="group_by"/>
                        <field name="filter_domain"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_kpi_dashboard_widget" model="ir.actions.act_window">
        <field name="name">Dashboard Widgets</field>
        <field name="res_model">hr.kpi.dashboard.widget</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_kpi_dashboard_widget" name="Dashboard Widgets" parent="menu_kpi_configuration" action="action_hr_kpi_dashboard_widget" sequence="40"/>
</odoo>
