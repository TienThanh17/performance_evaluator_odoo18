<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_kpi_score_scale_convert_wizard_form" model="ir.ui.view">
            <field name="name">hr.kpi.score.scale.convert.wizard.form</field>
            <field name="model">hr.kpi.score.scale.convert.wizard</field>
            <field name="arch" type="xml">
                <form string="Convert KPI Score Scale">
                    <sheet>
                        <group>
                            <field name="from_scale"/>
                            <field name="to_scale"/>
                        </group>
                        <div class="alert alert-warning" role="alert">
                            Existing KPI scores and thresholds will be converted to the target scale.
                            Use this instead of changing the score scale directly when KPI data already exists.
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_convert" type="object" string="Convert" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_hr_kpi_score_scale_convert_wizard" model="ir.actions.act_window">
            <field name="name">Convert KPI Score Scale</field>
            <field name="res_model">hr.kpi.score.scale.convert.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
