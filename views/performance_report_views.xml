<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════
             Dashboard Form View – sử dụng js_class OWL tùy chỉnh
             Đây là form chính để xem Performance Report theo phòng ban
        ════════════════════════════════════════════════════════════════ -->
        <record id="view_hr_performance_report_form" model="ir.ui.view">
            <field name="name">hr.performance.report.form</field>
            <field name="model">hr.performance.report</field>
            <field name="arch" type="xml">
                <!--
                    js_class="performance_dashboard_form" kích hoạt OWL renderer tùy chỉnh.
                    Vẫn cần khai báo các field để server đưa chúng vào response data.
                -->
                <form js_class="performance_dashboard_form">
                    <sheet>
                        <field name="department_id" invisible="1" />
                        <field name="department_name" invisible="1" />
                        <field name="period_id" invisible="1" />
                        <field name="period_type" invisible="1" />
                        <field name="start_date" invisible="1" />
                        <field name="end_date" invisible="1" />
                        <field name="deadline" invisible="1" />
                        <field name="period_status" invisible="1" />
                        <field name="active" invisible="1" />
                        <!-- evaluation_ids với các sub-field cần cho dashboard -->
                        <field name="evaluation_ids" invisible="1">
                            <list>
                                <field name="employee_id" />
                                <field name="job_id" />
                                <field name="total_p3_individual" />
                                <field name="performance_level" />
                                <field name="state" />
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             Edit Form View – dùng để chỉnh sửa record trực tiếp
             (priority cao hơn để tránh conflict với dashboard form)
        ════════════════════════════════════════════════════════════════ -->
        <record id="view_hr_performance_report_edit_form" model="ir.ui.view">
            <field name="name">hr.performance.report.edit.form</field>
            <field name="model">hr.performance.report</field>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <form string="Performance Report">
                    <sheet>
                        <group>
                            <group string="Period Info">
                                <field name="period_id" />
                                <field name="start_date" />
                                <field name="end_date" />
                                <field name="deadline" />
                                <field name="period_status" widget="badge" readonly="1"
                                    decoration-info="period_status == 'upcoming'"
                                    decoration-success="period_status == 'ongoing'"
                                    decoration-muted="period_status == 'closed'" />
                            </group>
                            <group string="Scope">
                                <field name="department_id" />
                                <field name="company_id" />
                                <field name="active" widget="boolean_toggle" />
                            </group>
                        </group>
                        <group string="Employees">
                            <field name="employee_id" widget="many2many_tags" nolabel="1" />
                        </group>
                        <group string="Email Notification">
                            <field name="subject" />
                            <field name="body" widget="html" />
                        </group>
                        <notebook>
                            <page string="Evaluations" name="evaluations">
                                <field name="evaluation_ids" readonly="1">
                                    <list>
                                        <field name="employee_id" />
                                        <field name="period_id" />
                                        <field name="total_p3_individual" />
                                        <field name="performance_level" widget="badge"
                                            decoration-success="performance_level == 'pass'"
                                            decoration-info="performance_level == 'excellent'"
                                            decoration-danger="performance_level == 'fail'" />
                                        <field name="state" widget="badge" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             List View
        ════════════════════════════════════════════════════════════════ -->
        <record id="view_hr_performance_report_list" model="ir.ui.view">
            <field name="name">hr.performance.report.list</field>
            <field name="model">hr.performance.report</field>
            <field name="arch" type="xml">
                <list string="Performance Reports">
                    <field name="department_id" />
                    <field name="period_id" />
                    <field name="period_type" />
                    <field name="start_date" />
                    <field name="end_date" />
                    <field name="period_status" widget="badge"
                        decoration-info="period_status == 'upcoming'"
                        decoration-success="period_status == 'ongoing'"
                        decoration-muted="period_status == 'closed'" />
                    <!--                    <field name="deadline"/>-->
                    <field name="active" widget="boolean_toggle" optional="hide" />
                </list>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             Search View
        ════════════════════════════════════════════════════════════════ -->
        <record id="view_hr_performance_report_search" model="ir.ui.view">
            <field name="name">hr.performance.report.search</field>
            <field name="model">hr.performance.report</field>
            <field name="arch" type="xml">
                <search>
                    <field name="department_id" />
                    <field name="period_id" />
                    <field name="period_type" />
                    <field name="start_date" />
                    <field name="end_date" />
                    <field name="period_status" />
                    <field name="employee_id" />

                    <filter string="Current Period" name="current_period"
                        domain="[
                        ('start_date', '&lt;=', context_today().strftime('%Y-%m-%d')),
                        ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))
                    ]" />

                    <separator />

                    <filter string="Monthly" name="monthly" domain="[('period_type', '=', 'monthly')]" />
                    <filter string="Quarterly" name="quarterly" domain="[('period_type', '=', 'quarterly')]" />
                    <filter string="Half-Yearly" name="half_yearly" domain="[('period_type', '=', 'biannual')]" />
                    <filter string="Yearly" name="yearly" domain="[('period_type', '=', 'yearly')]" />

                    <separator />

                    <filter string="Archived" name="archived"
                        domain="[('active', '=', False)]" />

                    <group expand="1" string="Group By">
                        <filter string="Department" name="group_by_department"
                            context="{'group_by': 'department_id'}" />
                        <filter string="Period" name="group_by_period"
                            context="{'group_by': 'period_type'}" />
                    </group>
                </search>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             Action &amp; Menu
        ════════════════════════════════════════════════════════════════ -->
        <record id="action_hr_performance_report" model="ir.actions.act_window">
            <field name="name">Performance Reports</field>
            <field name="res_model">hr.performance.report</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{'search_default_current_period': 1}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new Performance Report.
                </p>
            </field>
        </record>

        <menuitem
            id="menu_hr_performance_report"
            parent="kpi_employee_menu"
            name="Manage KPI Employee"
            sequence="20"
            action="action_hr_performance_report" />

    </data>
</odoo>
