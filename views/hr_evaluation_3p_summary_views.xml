<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_evaluation_3p_summary_list" model="ir.ui.view">
        <field name="name">hr.evaluation.3p.summary.list</field>
        <field name="model">hr.evaluation.3p.summary</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="department_id"/>
                <field name="period_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hr_evaluation_3p_summary_search" model="ir.ui.view">
        <field name="name">hr.evaluation.3p.summary.search</field>
        <field name="model">hr.evaluation.3p.summary</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="department_id"/>
                <field name="period_id"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_period" string="Period" context="{'group_by': 'period_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_hr_evaluation_3p_summary_form" model="ir.ui.view">
        <field name="name">hr.evaluation.3p.summary.form</field>
        <field name="model">hr.evaluation.3p.summary</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_aggregate" type="object" string="Aggregate" class="oe_highlight"/>
                    <button name="action_set_draft" type="object" string="Set to Draft" invisible="state == 'draft'"/>
                    <button name="action_export_excel" string="Xuất Excel" type="object" class="btn-secondary" icon="fa-file-excel-o"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_open_department_dashboard"
                                icon="fa-bar-chart"
                                invisible="not department_evaluation_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Dashboard</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="department_evaluation_id"/>
                            <field name="department_id"/>
                            <field name="period_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="line_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary Lines">
                            <field name="line_ids">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="job_id"/>
                                    <field name="p2_1_score_raw"/>
                                    <field name="p2_2_score_raw"/>
                                    <field name="p3_individual_score"/>
                                    <field name="p3_department_score"/>
                                    <field name="p3_1_score"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

</odoo>
