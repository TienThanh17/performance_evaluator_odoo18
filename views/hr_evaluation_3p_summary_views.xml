<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_evaluation_3p_summary_list" model="ir.ui.view">
        <field name="name">hr.evaluation.3p.summary.list</field>
        <field name="model">hr.evaluation.3p.summary</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name" />
                <field name="department_id" />
                <field name="period_id" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="view_hr_evaluation_3p_summary_search" model="ir.ui.view">
        <field name="name">hr.evaluation.3p.summary.search</field>
        <field name="model">hr.evaluation.3p.summary</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="department_id" />
                <field name="period_id" />
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]" />
                <group expand="0" string="Group By">
                    <filter name="group_department" string="Department"
                        context="{'group_by': 'department_id'}" />
                    <filter name="group_period" string="Period" context="{'group_by': 'period_id'}" />
                    <filter name="group_state" string="State" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_hr_evaluation_3p_summary_form" model="ir.ui.view">
        <field name="name">hr.evaluation.3p.summary.form</field>
        <field name="model">hr.evaluation.3p.summary</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_aggregate" type="object" string="Aggregate"
                        class="oe_highlight" />
                    <button name="action_set_draft" type="object" string="Set to Draft"
                        invisible="state == 'draft'" />
                    <button name="action_export_excel" string="Export Excel" type="object"
                        class="btn-secondary" icon="fa-file-excel-o" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"
                        options="{'clickable': '1'}" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                            name="action_open_department_dashboard"
                            icon="fa-bar-chart"
                            invisible="not department_evaluation_id"
                            groups="custom_adecsol_hr_performance_evaluator.group_admin,
                                    custom_adecsol_hr_performance_evaluator.group_hr,
                                    custom_adecsol_hr_performance_evaluator.group_manager">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Dashboard</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="department_evaluation_id" />
                            <field name="department_id" />
                            <field name="period_id" />
                        </group>
                        <group>
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="line_count" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary Lines">
                            <field name="line_ids">
                                <list create="0" delete="0" open_form_view="True">
                                    <field name="can_edit_manual_inputs" column_invisible="1" />
                                    <field name="employee_id" />
                                    <field name="job_id" />
                                    <field name="p2_1_score_raw" readonly="1" optional="show" />
                                    <field name="p2_2_score_raw" readonly="1" optional="show" />
                                    <field name="p3_individual_score" readonly="1" optional="show" />
                                    <field name="p3_department_score" readonly="1" optional="show" />
                                    <field name="p3_1_score" readonly="1" optional="show" />
                                    <field name="p3_2_revenue_list" widget="percentage" readonly="1"
                                        optional="show" />
                                </list>
                                <form string="3P Summary Line">
                                    <sheet>
                                        <field name="can_edit_manual_inputs" invisible="1" />
                                        <field name="summary_state" invisible="1" />

                                        <div class="oe_title">
                                            <h1>
                                                <field name="employee_id" readonly="1"
                                                    options="{'no_open': True}" />
                                            </h1>
                                        </div>

                                        <group>
                                            <group string="Payroll Period Information">
                                                <field name="employee_code" readonly="1" />
                                                <field name="job_id" readonly="1" />
                                                <field name="department_id" readonly="1" />
                                                <field name="period_id" readonly="1" />
                                                <field name="summary_id" readonly="1" />
                                            </group>

                                            <group string="System Evaluation Scores">
                                                <field name="p2_1_score_raw" readonly="1" />
                                                <field name="p2_2_score_raw" readonly="1" />
                                                <field name="p3_individual_score" readonly="1" />
                                                <field name="p3_department_score" readonly="1" />
                                                <field name="p3_1_score" readonly="1" />
                                                <field name="p3_2_revenue" widget="percentage"
                                                    readonly="not can_edit_manual_inputs" />
                                            </group>
                                        </group>

                                        <group>
                                            <group string="P1 Standards">
                                                <label for="p1_base_salary" />
                                                <div class="o_row">
                                                    <field name="p1_base_salary"
                                                        readonly="not can_edit_manual_inputs" />
                                                    <button name="action_refetch_p1_base_salary"
                                                        type="object" icon="fa-refresh"
                                                        title="Reload P1.1 amount from the job position setup"
                                                        class="btn btn-sm btn-link text-success"
                                                        invisible="not can_edit_manual_inputs" />
                                                </div>

                                                <label for="p1_allowance" />
                                                <div class="o_row">
                                                    <field name="p1_allowance"
                                                        readonly="not can_edit_manual_inputs" />
                                                    <button name="action_refetch_p1_allowance"
                                                        type="object" icon="fa-refresh"
                                                        title="Reload P1.2 amount from the job position setup"
                                                        class="btn btn-sm btn-link text-success"
                                                        invisible="not can_edit_manual_inputs" />
                                                </div>
                                            </group>

                                            <group string="P2 Standards">
                                                <label for="p2_1_base_amount" />
                                                <div class="o_row">
                                                    <field name="p2_1_base_amount"
                                                        readonly="not can_edit_manual_inputs" />
                                                    <button name="action_refetch_p2_1_base_amount"
                                                        type="object" icon="fa-refresh"
                                                        title="Reload the P2.1 standard amount from the job position setup"
                                                        class="btn btn-sm btn-link text-success"
                                                        invisible="not can_edit_manual_inputs" />
                                                </div>

                                                <label for="p2_2_base_amount" />
                                                <div class="o_row">
                                                    <field name="p2_2_base_amount"
                                                        readonly="not can_edit_manual_inputs" />
                                                    <button name="action_refetch_p2_2_base_amount"
                                                        type="object" icon="fa-refresh"
                                                        title="Reload the P2.2 standard amount from the job position setup"
                                                        class="btn btn-sm btn-link text-success"
                                                        invisible="not can_edit_manual_inputs" />
                                                </div>
                                            </group>

                                            <group string="P3 Standards">
                                                <label for="p3_1_base_amount" />
                                                <div class="o_row">
                                                    <field name="p3_1_base_amount"
                                                        readonly="not can_edit_manual_inputs" />
                                                    <button name="action_refetch_p3_1_base_amount"
                                                        type="object" icon="fa-refresh"
                                                        title="Reload the P3.1 standard amount from the job position setup"
                                                        class="btn btn-sm btn-link text-success"
                                                        invisible="not can_edit_manual_inputs" />
                                                </div>

                                                <label for="p3_2_base_amount" />
                                                <div class="o_row">
                                                    <field name="p3_2_base_amount"
                                                        readonly="not can_edit_manual_inputs" />
                                                    <button name="action_refetch_p3_2_base_amount"
                                                        type="object" icon="fa-refresh"
                                                        title="Reload the P3.2 standard amount from the job position setup"
                                                        class="btn btn-sm btn-link text-success"
                                                        invisible="not can_edit_manual_inputs" />
                                                </div>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

</odoo>