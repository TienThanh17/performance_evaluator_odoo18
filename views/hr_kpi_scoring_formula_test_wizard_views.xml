<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_kpi_scoring_formula_test_wizard_form" model="ir.ui.view">
        <field name="name">hr.kpi.scoring.formula.test.wizard.form</field>
        <field name="model">hr.kpi.scoring.formula.test.wizard</field>
        <field name="arch" type="xml">
            <form string="Test KPI Scoring Formula">
                <sheet>
                    <group>
                        <field name="formula_id" readonly="1"/>
                        <field name="test_actual"/>
                        <field name="test_target"/>
                    </group>
                    <group invisible="not result_computed">
                        <field name="test_result" readonly="1"/>
                        <field name="result_status"
                            widget="badge"
                            decoration-success="result_status in ('pass', 'excellent')"
                            decoration-danger="result_status == 'fail'"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_compute" type="object" string="Tinh diem" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
