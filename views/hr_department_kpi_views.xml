<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated form view for KPI Line used in popup (Add KPI) -->
    <record id="view_hr_kpi_department_line_form_popup" model="ir.ui.view">
        <field name="name">hr.kpi.department.line.form.popup</field>
        <field name="model">hr.department.kpi.template.line</field>
        <field name="arch" type="xml">
            <form string="KPI Line">
                <sheet>
                    <div class="oe_title">
                        <h2 class="mb-1">
                            <field name="name"
                                placeholder="Title KPI" />
                        </h2>
                    </div>

                    <field name="is_section" invisible="1" />
                    <field name="child_template_line_count" invisible="1" />
                    <group invisible="is_section">
                        <group string="KPI Info">
                            <field name="department_kpi_id" invisible="1" />
                            <field name="pillar_id" options="{'no_create': True}" />
                            <field name="category_id"
                                domain="[('pillar_id', '=', pillar_id)]"
                                options="{'no_create': True}" />
                            <field name="parent_line_id"
                                domain="[('department_kpi_id', '=', department_kpi_id), ('id', '!=', id)]"
                                options="{'no_create': True}" />
                            <field name="kpi_type" />
                            <field name="unit"
                                invisible="kpi_type != 'quantitative'" />
                            <field name="scoring_formula_id"
                                invisible="kpi_type != 'quantitative'"
                                options="{'no_create': True}" />
                            <field name="weight" />
                            <field name="score_scale_base_override" />
                        </group>
                        <group string="Auto Compute" invisible="kpi_type != 'quantitative'">
                            <field name="is_auto" readonly="1"
                                invisible="kpi_type != 'quantitative'" />
                            <field name="dept_source_type" invisible="kpi_type != 'quantitative'" />
                            <field name="data_source_id" invisible="kpi_type != 'quantitative' or dept_source_type != 'data_source'" />
                        </group>
                    </group>

                    <group invisible="is_section">
                        <group string="Target"
                            invisible="kpi_type != 'quantitative'">
                            <field name="target" />
                        </group>
                    </group>

                    <group string="Child KPI Template Lines"
                        invisible="is_section or child_template_line_count == 0">
                        <field name="child_template_rows_json"
                            widget="kpi_child_template_matrix"
                            readonly="1" nolabel="1" colspan="2" />
                    </group>

                    <group string="Description">
                        <field name="description" placeholder="KPI Description"
                            style="width: 100%; min-width: 400px;" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_department_kpi_form" model="ir.ui.view">
        <field name="name">hr.department.kpi.form</field>
        <field name="model">hr.department.kpi.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="%(custom_adecsol_hr_performance_evaluator.action_hr_department_kpi_generate_wizard)d"
                        string="Generate Evaluations" type="action" class="btn-primary" />
                </header>
                <sheet>
                    <group>
                        <group string="General Information">
                            <field name="name" />
                            <field name="department_id" />
                            <field name="period_type" />
                            <field name="scoring_profile_id" />
                        </group>
                        <group string="Bonus Calculation Weights">
                            <!-- Trọng số mới: dept_weight + individual_weight -->
                            <field name="dept_weight" widget="percentage" class="oe_inline"/>
                            <field name="individual_weight" widget="percentage" class="oe_inline"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="P3.1.2 KPI Phòng Ban">
                            <field name="kpi_line_ids" widget="kpi_one2many"
                                context="{'form_view_ref': 'custom_adecsol_hr_performance_evaluator.view_hr_kpi_department_line_form_popup'}">
                                <list editable="bottom" decoration-bf="is_section">
                                    <field name="sequence" widget="handle" />
                                    <field name="is_section" column_invisible="True" />
                                    <field name="child_template_rows_json" column_invisible="1" />
                                    <field name="child_template_line_count" column_invisible="1" />

                                    <field name="name" string="Title" />
                                    <field name="pillar_id" options="{'no_create': True}" />
                                    <field name="category_id"
                                        options="{'no_create': True}"
                                        domain="[('pillar_id', '=', pillar_id)]"
                                        invisible="is_section"
                                        optional="show" />
                                    <field name="parent_line_id"
                                        domain="[('department_kpi_id', '=', parent.id), ('id', '!=', id)]"
                                        options="{'no_create': True}"
                                        invisible="is_section"
                                        optional="show" />
                                    <field name="description"
                                        string="Info"
                                        widget="kpi_description_icon"
                                        invisible="is_section"
                                        optional="show" />

                                    <field name="kpi_type" invisible="is_section" />
                                    <field name="unit"
                                        string="Unit"
                                        invisible="is_section or kpi_type != 'quantitative'"
                                        optional="show" />
                                    <field name="target" string="Target"
                                        invisible="is_section or kpi_type != 'quantitative'" />
                                    <field name="scoring_formula_id"
                                        invisible="is_section or kpi_type != 'quantitative'"
                                        options="{'no_create': True}" />

                                    <field name="is_auto" column_invisible="1" />
                                    <field name="dept_source_type"
                                        invisible="is_section or not is_auto" />
                                    <field name="data_source_id"
                                        invisible="is_section or not is_auto or dept_source_type != 'data_source'" />

                                    <field name="weight" invisible="is_section" />
                                    <field name="score_scale_base_override"
                                        invisible="is_section"
                                        optional="show" />
                                    <control>
                                        <create name="add_section" string="Add Section"
                                            context="{'default_is_section': True}"
                                        />
                                        <create name="add_kpi" string="Add KPI" />
                                    </control>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_department_kpi_list" model="ir.ui.view">
        <field name="name">hr.department.kpi.list</field>
        <field name="model">hr.department.kpi.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="department_id" />
                <field name="period_type" />
                <!-- Hiển thị trọng số mới -->
                <field name="dept_weight" string="Department Weight" />
                <field name="individual_weight" string="Individual Weight" />
            </list>
        </field>
    </record>

    <record id="action_hr_department_kpi" model="ir.actions.act_window">
        <field name="name">Department KPIs</field>
        <field name="res_model">hr.department.kpi.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_kpi_department_form" name="KPI Department Template"
        parent="menu_kpi_template" sequence="20"
        action="action_hr_department_kpi" />
</odoo>
