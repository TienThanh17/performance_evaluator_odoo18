<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated form view for KPI Line used in popup (Add KPI) -->
    <record id="view_hr_kpi_department_line_form_popup" model="ir.ui.view">
        <field name="name">hr.kpi.department.line.form.popup</field>
        <field name="model">hr.department.kpi.template.line</field>
        <field name="arch" type="xml">
            <form string="KPI Line">
                <sheet>
                    <div class="oe_title">
                        <h2 class="mb-1">
                            <field name="name"
                                placeholder="Title KPI" />
                        </h2>
                    </div>

                    <field name="is_section" invisible="1" />
                    <field name="child_template_line_count" invisible="1" />
                    <group>
                        <group string="KPI Info">
                            <field name="department_kpi_id" invisible="1" />
                            <field name="pillar_id" options="{'no_create': True}" />
                            <field name="parent_line_id"
                                options="{'no_create': True}" />
                            <field name="kpi_type" invisible="is_section" />
                            <field name="manual_scoring_type"
                                invisible="is_section or kpi_type != 'manual'" />
                            <field name="unit"
                                invisible="is_section or kpi_type != 'auto'" />
                            <field name="scoring_formula_id"
                                invisible="is_section or kpi_type != 'auto'"
                                options="{'no_create': True}" />
                            <field name="weight" />
                            <field name="wipeout_if_child_zero"
                                invisible="not is_section" />
                        </group>
                        <group string="Auto Compute" invisible="is_section or kpi_type != 'auto'">
                            <field name="is_auto" readonly="1"
                                invisible="kpi_type != 'auto'" />
                            <field name="dept_source_type" invisible="kpi_type != 'auto'" />
                            <field name="data_source_id"
                                invisible="kpi_type != 'auto' or dept_source_type != 'data_source'" />
                        </group>
                    </group>

                    <group invisible="is_section">
                        <group string="Target"
                            invisible="kpi_type != 'auto'">
                            <field name="target" />
                        </group>
                    </group>

                    <group string="Child KPI Template Lines"
                        invisible="is_section or child_template_line_count == 0">
                        <field name="child_template_rows_json"
                            widget="kpi_child_template_matrix"
                            readonly="1" nolabel="1" colspan="2" />
                    </group>

                    <group string="Description">
                        <field name="description" placeholder="KPI Description"
                            style="width: 100%; min-width: 400px;" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_department_kpi_form" model="ir.ui.view">
        <field name="name">hr.department.kpi.form</field>
        <field name="model">hr.department.kpi.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="%(custom_adecsol_hr_performance_evaluator.action_hr_department_kpi_generate_wizard)d"
                        string="Generate Evaluations" type="action" class="btn-primary" />
                </header>
                <sheet>
                    <group>
                        <group string="General Information">
                            <field name="name" />
                            <field name="department_id" />
                            <field name="period_type" />
                            <field name="scoring_profile_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="P3.1.2">
                            <h2 class="text-primary mt-2 mb-3">
                                <field name="pillar_p3_dept_name" readonly="1" nolabel="1" />
                            </h2>
                            <field name="kpi_line_ids" widget="kpi_template_tree_one2many"
                                context="{'form_view_ref': 'custom_adecsol_hr_performance_evaluator.view_hr_kpi_department_line_form_popup', 'default_pillar_code': 'p3_department'}">
                                <list editable="bottom" decoration-bf="is_section">
                                    <field name="sequence" widget="kpi_template_tree_handle" />
                                    <field name="is_section" column_invisible="True" />
                                    <field name="child_template_rows_json" column_invisible="1" />
                                    <field name="child_template_line_count" column_invisible="1" />

                                    <field name="name" string="Title" width="450px" />
                                    <!-- <field name="pillar_id" options="{'no_create': True}" /> -->
                                    <!-- <field name="parent_line_id"
                                        domain="[('department_kpi_id', '=', parent.id), ('id', '!=', id)]"
                                        options="{'no_create': True}"
                                        invisible="is_section"
                                        optional="show" /> -->
                                    <field name="description"
                                        string="Info"
                                        widget="kpi_description_icon"
                                        invisible="is_section"
                                        optional="show" width="100px" />

                                    <field name="kpi_type" invisible="is_section" width="100px" />
                                    <field name="manual_scoring_type"
                                        invisible="is_section or kpi_type != 'manual'"
                                        optional="hide" width="140px" />
                                    <field name="unit"
                                        string="Unit"
                                        invisible="is_section or kpi_type != 'auto'"
                                        optional="show" width="320px" />

                                    <field name="scoring_formula_id"
                                        invisible="is_section or kpi_type != 'auto'"
                                        options="{'no_create': True}" width="320px" />

                                    <field name="is_auto" column_invisible="1" />
                                    <field name="dept_source_type"
                                        invisible="is_section or not is_auto" optional="hide" width="130px" />
                                    <field name="data_source_id"
                                        invisible="is_section or not is_auto or dept_source_type != 'data_source'" optional="hide" width="150px" />

                                    <field name="target" string="Target"
                                        invisible="is_section or kpi_type != 'auto'" width="100px" />
                                    <field name="weight" width="80px" />
                                    <field name="wipeout_if_child_zero"
                                        invisible="not is_section"
                                        optional="hide" width="100px" />
                                    <button name="action_open_popup" type="object"
                                        icon="fa-pencil" title="Open Details"
                                        width="40px" />
                                    <control>
                                        <create name="add_section" string="Add Section"
                                            context="{'default_is_section': True, 'default_display_type': 'line_section', 'default_pillar_code': 'p3_department'}"
                                        />
                                        <create name="add_kpi" string="Add KPI"
                                            context="{'default_pillar_code': 'p3_department'}" />
                                    </control>
                                </list>
                            </field>
                            <div
                                class="o_perf_summary mt-3 d-flex justify-content-between align-items-start">
                                <div
                                    class="o_perf_summary_body o_perf_summary_body_left flex-grow-1 pe-3">
                                    <div class="o_perf_summary_title">Scoring Formula</div>
                                    <div class="text-muted mt-2" style="font-size: 14px;">
                                        <strong>Department KPI Score</strong> = ∑ (Top-level P3.1.2
                                        Line Score × Weight) / ∑ Weight<br />
                                        <span
                                            style="font-size: 14px; font-style: italic;">
                                            If the total top-level P3.1.2 weight is 0, the system
                                        falls back to the average of top-level P3.1.2 line scores.
                                        </span>

                                        <div
                                            class="mt-3">
                                            <details>
                                                <summary
                                                    class="btn btn-sm btn-outline-info text-start"
                                                    style="cursor: pointer;">
                                                    <i class="fa fa-info-circle me-1" />
                                                    <strong>Line Scoring Guide</strong>
                                                </summary>

                                                <div
                                                    class="mt-2 p-3 border rounded bg-light text-dark">
                                                    <strong>- Manual KPI</strong><br /> Binary: Pass
                                        = 100 points, Fail = 0 points.<br /> Rating: 0 to 5 stars,
                                        each star = 20 points.<br /> Score: enter the score directly
                                        into the score field.<br />
                        <br />
                        <strong>- Auto KPI</strong><br />
                                        Score is calculated from <strong>Target</strong> and <strong>
                                        Actual</strong> based on the selected <strong>Scoring
                                        Formula</strong>. If a data source is linked, the system can
                                        auto-fill <strong>Actual</strong> before applying the
                                        formula. </div>
                                            </details>
                                        </div>
                                    </div>
                                </div>

                                <div class="o_perf_summary_body o_perf_summary_body_right">
                                    <div class="o_perf_summary_title">Evaluation Results</div>
                                    <div class="text-muted mt-2" style="font-size: 14px;">
                                        Calculated when this KPI template is used in a department
                                        evaluation.
                                    </div>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_department_kpi_list" model="ir.ui.view">
        <field name="name">hr.department.kpi.list</field>
        <field name="model">hr.department.kpi.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="department_id" />
                <field name="period_type" />
            </list>
        </field>
    </record>

    <record id="action_hr_department_kpi" model="ir.actions.act_window">
        <field name="name">Department KPIs</field>
        <field name="res_model">hr.department.kpi.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_kpi_department_form" name="KPI Department Template"
        parent="menu_kpi_template" sequence="20"
        action="action_hr_department_kpi" />
</odoo>
