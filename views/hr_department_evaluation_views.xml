<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_department_evaluation_line_form_popup" model="ir.ui.view">
        <field name="name">hr.department.evaluation.line.form.popup</field>
        <field name="model">hr.department.evaluation.line</field>
        <field name="arch" type="xml">
            <form string="Evaluation Line">
                <sheet>
                    <field name="is_section" invisible="1" />
                    <field name="is_auto" invisible="1" />
                    <field name="is_manager" invisible="1" />
                    <field name="is_hr" invisible="1" />
                    <field name="is_admin" invisible="1" />
                    <field name="evaluation_state" invisible="1" />

                    <div class="oe_title">
                        <h2 class="mb-1">
                            <field name="name" placeholder="Key Performance Area" readonly="1" />
                        </h2>
                    </div>

                    <group string="Structure">
                        <group>
                            <field name="pillar_id" options="{'no_create': True}" readonly="1" />
                        </group>
                        <group>
                            <field name="parent_line_id"
                                domain="[('evaluation_id', '=', evaluation_id), ('id', '!=', id)]"
                                options="{'no_create': True}" readonly="1" />
                        </group>
                    </group>

                    <group string="Assessment" invisible="is_section or kpi_type == 'auto'">
                        <group>
                            <field name="manual_scoring_type"
                                invisible="kpi_type != 'manual'" readonly="1" />
                            <label for="manager_rating_binary" string="Manager Rating"
                                invisible="kpi_type != 'manual' or manual_scoring_type != 'binary'" />
                            <field name="manager_rating_binary" nolabel="1" widget="radio"
                                invisible="kpi_type != 'manual' or manual_scoring_type != 'binary'"
                                readonly="1" />

                            <label for="manager_rating_selection" string="Manager Rating"
                                invisible="kpi_type != 'manual' or manual_scoring_type != 'rating'" />
                            <field name="manager_rating_selection" nolabel="1"
                                widget="priority_onchange"
                                invisible="kpi_type != 'manual' or manual_scoring_type != 'rating'"
                                readonly="1" />

                            <label for="manager_rating_score" string="Manager Score"
                                invisible="kpi_type != 'manual' or manual_scoring_type != 'score'" />
                            <field name="manager_rating_score" nolabel="1"
                                invisible="kpi_type != 'manual' or manual_scoring_type != 'score'"
                                readonly="1" />
                        </group>
                        <group />
                    </group>

                    <group string="Target / Actual" invisible="is_section or kpi_type != 'auto'">
                        <group>
                            <field name="target" readonly="1" />
                            <field name="unit" invisible="kpi_type != 'auto'" readonly="1" />
                        </group>
                        <group>
                            <field name="actual" placeholder="Actual value"
                                readonly="not is_admin and not is_manager" />
                        </group>
                    </group>

                    <group string="Scoring">
                        <field name="final_score_badge_class" invisible="1" />
                        <field name="final_score_badge_text" string="Score"
                            widget="badge" readonly="1"
                            decoration-info="final_score_badge_class == 'o_kpi_badge_excellent'"
                            decoration-success="final_score_badge_class == 'o_kpi_badge_pass'"
                            decoration-danger="final_score_badge_class == 'o_kpi_badge_fail'" />
                    </group>

                    <group string="KPI Info">
                        <group>
                            <field name="kpi_type" invisible="is_section" readonly="1" />
                            <field name="manual_scoring_type"
                                invisible="kpi_type != 'manual' or is_section" readonly="1" />
                            <field name="weight" readonly="1" />
                            <field name="wipeout_if_child_zero"
                                invisible="not is_section"
                                readonly="1" />
                        </group>
                        <group invisible="kpi_type != 'auto' or is_section">
                            <field name="is_auto" readonly="1"
                                invisible="kpi_type != 'auto'" />
                            <field name="dept_source_type" invisible="kpi_type != 'auto'"
                                readonly="1" />
                            <field name="data_source_id"
                                invisible="kpi_type != 'auto' or dept_source_type != 'data_source'"
                                readonly="1" />
                            <field name="scoring_formula_id"
                                invisible="kpi_type != 'auto'"
                                readonly="1" />
                        </group>
                    </group>

                    <group string="Comments" invisible="is_section">
                        <field name="manager_comment" widget="html"
                            readonly="not is_admin and not is_manager"
                            options="{'resizable': false}"
                            style="min-height: 100px; max-height: 100px; overflow-y: auto;" />
                    </group>

                    <group string="KPI Description" invisible="is_section">
                        <field name="description" widget="html" placeholder="KPI Description"
                            readonly="1"
                            options="{'resizable': false}"
                            style="min-height: 100px; max-height: 100px; overflow-y: auto;" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_department_performance_evaluation_form" model="ir.ui.view">
        <field name="name">hr.department.performance.evaluation.form</field>
        <field name="model">hr.department.performance.evaluation</field>
        <field name="arch" type="xml">
            <form string="Department Performance Evaluation">
                <header>
                    <field name="is_manager" invisible="1" />
                    <field name="is_hr" invisible="1" />
                    <field name="is_admin" invisible="1" />
                    <!-- <button name="action_archive_with_report" string="Archive" type="object"
                            invisible="not active"/>
                    <button name="action_unarchive_with_report" string="Unarchive" type="object"
                            class="oe_highlight"
                            invisible="active"/> -->
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight"
                        invisible="state != 'draft' or (not is_admin and not is_manager)" />
                    <button name="action_approve" string="Approve" type="object"
                        class="oe_highlight"
                        invisible="state != 'submitted' or (not is_admin and not is_manager)" />
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state in ('approved', 'cancel') or (not is_admin and not is_manager)" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,submitted,approved" />
                </header>
                <sheet>
                    <field name="active" invisible="1" />
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                            name="action_open_department_dashboard"
                            icon="fa-bar-chart"
                            invisible="not id or (not is_admin and not is_manager)">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Dashboard</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="department_id" readonly="1" />
                            <field name="department_kpi_id" readonly="1" />
                            <field name="period_id" readonly="1" />
                        </group>
                        <group>
                            <field name="start_date" readonly="1" />
                            <field name="end_date" readonly="1" />
                            <field name="period_status" widget="badge" readonly="1"
                                decoration-info="period_status == 'upcoming'"
                                decoration-success="period_status == 'ongoing'"
                                decoration-muted="period_status == 'closed'" />
                            <!-- <field name="deadline" readonly="state != 'draft'"/> -->
                        </group>
                    </group>
                    <group>
                        <!-- <group string="Scores">
                            <group>
                                <field name="dept_kpi_score" string="Department KPI Score"
                                    widget="badge"
                                    readonly="1" />
                            </group>
                        </group> -->
                        <div
                            class="score_value font-weight-bold mt-3"
                            style="font-size: 24px; color: #7c3aed;">
                            <label for="dept_kpi_score"
                                string="P3.1.2 Total"
                                class="text-uppercase small fw-bold mb-0 text-nowrap"
                                style="color: #7c3aed;" />

                            <field name="dept_kpi_score" readonly="1" nolabel="1"
                                class="w-auto mb-0" />
                        </div>
                    </group>
                    <notebook>
                        <page string="P3.1.2 Department KPI">
                            <!-- <h2 class="text-primary mt-2 mb-3">
                                <field name="pillar_p3_dept_name" readonly="1" nolabel="1" />
                            </h2> -->
                            <button name="action_compute_auto_kpi" string="Compute KPI"
                                type="object"
                                class="oe_highlight"
                                invisible="state in ('approved', 'cancel') or (not is_admin and not is_manager)" />
                            <field name="evaluation_line_ids" widget="kpi_one2many"
                                readonly="state in ('approved', 'cancel')"
                                context="{'parent_field': 'evaluation_id', 'form_view_ref': 'custom_adecsol_hr_performance_evaluator.view_hr_department_evaluation_line_form_popup', 'title_field': 'name'}">
                                <list editable="bottom"
                                    decoration-bf="is_section"
                                    create='0' delete="0"
                                >
                                    <field name="is_section" column_invisible="1" />
                                    <field name="is_auto" column_invisible="1" />
                                    <field name="is_manager" column_invisible="1" />
                                    <field name="is_admin" column_invisible="1" />
                                    <field name="dept_source_type" column_invisible="1" />

                                    <field name="name" string="Title" readonly="1"
                                        width="500px" />
                                    <field name="description"
                                        string="Info"
                                        widget="kpi_description_icon"
                                        width="100px"
                                        invisible="is_section"
                                        optional="show" />

                                    <field name="pillar_id"
                                        options="{'no_create': True}"
                                        readonly="1"
                                        invisible="is_section"
                                        width="200px"
                                        optional="hide" />
                                    <field name="parent_line_id"
                                        domain="[('evaluation_id', '=', parent.id), ('id', '!=', id)]"
                                        options="{'no_create': True}"
                                        readonly="1"
                                        invisible="is_section"
                                        width="200px"
                                        optional="hide" />

                                    <field name="kpi_type" readonly="1" invisible="is_section"
                                        width="100px" />
                                    <field name="manual_scoring_type"
                                        readonly="1"
                                        invisible="is_section or kpi_type != 'manual'"
                                        width="150px" optional="hide" />

                                    <field name="dept_source_type" optional="hide" readonly="1"
                                        invisible="is_section" width="200px" />
                                    <field name="data_source_id" optional="hide" readonly="1"
                                        invisible="is_section or dept_source_type != 'data_source'"
                                        width="200px" />
                                    <field name="manager_comment" optional="hide" width="200px"
                                        invisible="is_section"
                                        readonly="not is_admin and not is_manager" />

                                    <field name="unit" optional="show" readonly="1"
                                        invisible="is_section or kpi_type != 'auto'" width="320px" />
                                    <field name="scoring_formula_id" optional="show" readonly="1"
                                        invisible="is_section"
                                        width="320px" />
                                    <field name="target" readonly="1"
                                        invisible="is_section or kpi_type != 'auto'" width="100px" />
                                    <field name="actual"
                                        readonly="not is_admin and not is_manager"
                                        invisible="is_section or kpi_type != 'auto'" width="100px" />
                                    <field name="wipeout_if_child_zero"
                                        invisible="not is_section"
                                        optional="hide"
                                        readonly="1" width="120px" />

                                    <field name="manager_rating_binary"
                                        string="Manager Rating (Y/N)"
                                        invisible="is_section or kpi_type != 'manual' or manual_scoring_type != 'binary'"
                                        column_invisible="not parent.has_binary_kpi"
                                        width="140px"
                                        readonly="1"
                                    />
                                    <field name="manager_rating_selection"
                                        string="Manager Rating" widget="priority_onchange"
                                        invisible="is_section or kpi_type != 'manual' or manual_scoring_type != 'rating'"
                                        column_invisible="not parent.has_rating_kpi"
                                        width="120px"
                                        readonly="1"
                                    />
                                    <field name="manager_rating_score" string="Manager Score"
                                        invisible="is_section or kpi_type != 'manual' or manual_scoring_type != 'score'"
                                        column_invisible="not parent.has_score_kpi"
                                        width="120px"
                                        readonly="1"
                                    />
                                    <field name="weight" readonly="1" width="90px" />

                                    <field name="final_score_badge_class" column_invisible="1" />
                                    <field name="final_score_badge_text" string="Score" readonly="1"
                                        widget="badge"
                                        width="100px"
                                        decoration-info="final_score_badge_class == 'o_kpi_badge_excellent'"
                                        decoration-success="final_score_badge_class == 'o_kpi_badge_pass'"
                                        decoration-danger="final_score_badge_class == 'o_kpi_badge_fail'" />

                                    <button name="action_open_popup" type="object"
                                        icon="fa-pencil" title="Open Details"
                                        invisible="not parent.is_admin and not parent.is_manager"
                                        width="70px"
                                    />

                                    <control>
                                        <create name="add_section" string="Add Section"
                                            context="{'default_is_section': True, 'default_display_type': 'line_section'}" />
                                        <create name="add_kpi" string="Add KPI" />
                                    </control>
                                </list>
                            </field>
                            <div
                                class="o_perf_summary mt-3 d-flex justify-content-between align-items-start">
                                <div
                                    class="o_perf_summary_body o_perf_summary_body_left flex-grow-1 pe-3">
                                    <div class="o_perf_summary_title">Scoring Formula</div>
                                    <div class="text-muted mt-2" style="font-size: 14px;">
                                        <strong>Department KPI Score</strong> = ∑ (Top-level P3.1.2
                                        Line Score × Weight) / ∑ Weight<br />
            <span
                                            style="font-size: 14px; font-style: italic;">
                                            If the total top-level P3.1.2 weight is 0, the system
                                        falls back to the average of top-level P3.1.2 line scores.
                                        </span>
            
            <div
                                            class="mt-3">
                                            <details>
                                                <summary
                                                    class="btn btn-sm btn-outline-info text-start"
                                                    style="cursor: pointer;">
                                                    <i class="fa fa-info-circle me-1" />
                                                    <strong>Line Scoring Guide</strong>
                                                </summary>

                                                <div
                                                    class="mt-2 p-3 border rounded bg-light text-dark">
                                                    <strong>- Manual KPI</strong><br /> Binary: Pass
                                        = 100 points, Fail = 0 points.<br /> Rating: 0 to 5 stars,
                                        each star = 20 points.<br /> Score: enter the score directly
                                        into the score field.<br />
                        <br />
                        <strong>- Auto KPI</strong><br />
                                        Score is calculated from <strong>Target</strong> and <strong>
                                        Actual</strong> based on the selected <strong>Scoring
                                                        Formula</strong>. If a data source is
                                        linked, the system can auto-fill <strong>Actual</strong>
                                        before applying the formula. </div>
                                            </details>
                                        </div>
                                    </div>
                                </div>

                                <div class="o_perf_summary_body o_perf_summary_body_right">
                                    <div class="o_perf_summary_title">Evaluation Results</div>
                                    <div class="o_perf_summary_score">
                                        <span class="o_perf_label">Department KPI Score</span>
                                        <span class="o_perf_value">
                                            <field name="dept_kpi_score" />
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_department_performance_evaluation_list" model="ir.ui.view">
        <field name="name">hr.department.performance.evaluation.list</field>
        <field name="model">hr.department.performance.evaluation</field>
        <field name="arch" type="xml">
            <list string="Department Performance Evaluations">
                <field name="name" />
                <field name="department_id" />
                <field name="period_id" />
                <field name="period_status" widget="badge"
                    decoration-info="period_status == 'upcoming'"
                    decoration-success="period_status == 'ongoing'"
                    decoration-muted="period_status == 'closed'" />
                <!--                <field name="department_score" />-->
                <!--                <field name="department_level" />-->
                <field name="state" />
                <field name="active" widget="boolean_toggle" optional="hide" />
            </list>
        </field>
    </record>

    <!-- Search View for Department Performance Evaluation -->
    <record id="view_hr_department_performance_evaluation_search" model="ir.ui.view">
        <field name="name">hr.department.performance.evaluation.search</field>
        <field name="model">hr.department.performance.evaluation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />

                <field name="department_id" />
                <field name="department_kpi_id" />
                <field name="performance_report_id" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="period_status" />
                <field name="state" />

                <filter string="Current Period" name="current_period"
                    domain="[
                    ('start_date', '&lt;=', context_today().strftime('%Y-%m-%d')),
                    ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))
                ]" />

                <separator />

                <filter string="Draft" name="draft"
                    domain="[('state', '=', 'draft')]" />
                <filter string="Submitted" name="submitted"
                    domain="[('state', '=', 'submitted')]" />
                <filter string="Approved" name="approved"
                    domain="[('state', '=', 'approved')]" />
                <filter string="Cancelled" name="cancelled"
                    domain="[('state', '=', 'cancel')]" />

                <separator />

                <!-- <filter string="Upcoming" name="upcoming"
                    domain="[('period_status', '=', 'upcoming')]"/>
                <filter string="Ongoing" name="ongoing"
                    domain="[('period_status', '=', 'ongoing')]"/>
                <filter string="Closed" name="closed"
                    domain="[('period_status', '=', 'closed')]"/>

                <separator/> -->

                <filter string="Archived" name="archived"
                    domain="[('active', '=', False)]" />

                <group expand="1" string="Group By">
                    <filter string="Period" name="group_by_period"
                        context="{'group_by': 'period_id'}" />
                    <filter string="Department" name="group_by_department"
                        context="{'group_by': 'department_id'}" />
                    <filter string="Status" name="group_by_state"
                        context="{'group_by': 'state'}" />
                    <!-- <filter string="Period Status" name="group_by_period_status"
                        context="{'group_by': 'period_status'}"/> -->
                </group>
            </search>
        </field>
    </record>

</odoo>
