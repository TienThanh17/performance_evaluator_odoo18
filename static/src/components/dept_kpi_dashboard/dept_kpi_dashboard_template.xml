<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="performance_evaluator.DeptKpiDashboard">
<div class="o_dept_kpi_page" t-ref="dashboardRoot">

  <!-- ══ Header / Selector Bar ══ -->
  <div class="o_dept_kpi_header_bar">
    <div class="o_dept_kpi_brand">
      <i class="fa fa-building"/>
      <span class="o_dept_kpi_brand_title">Department KPI Dashboard</span>
    </div>

    <div class="o_dept_kpi_header_controls">
      <div class="o_dept_kpi_selectors">
      <!-- Department selector -->
        <div class="o_dept_kpi_selector_group">
          <label>Department:</label>
          <select t-on-change="onSelectDepartment">
            <option value="">— All Departments —</option>
            <t t-foreach="state.departments" t-as="dept" t-key="dept.id">
              <option t-att-value="dept.id"
                      t-att-selected="dept.id === state.selectedDepartmentId"
                      t-esc="dept.name"/>
            </t>
          </select>
        </div>

        <!-- Evaluation selector -->
        <t t-if="state.evaluations.length">
          <div class="o_dept_kpi_selector_group">
            <label>Evaluation:</label>
            <select t-on-change="onSelectEvaluation">
              <t t-foreach="state.evaluations" t-as="ev" t-key="ev.id">
                <option t-att-value="ev.id"
                        t-att-selected="ev.id === state.selectedEvaluationId"
                        t-esc="ev.name"/>
              </t>
            </select>
          </div>
        </t>
      </div>

      <button
        t-if="state.phase === 'done'"
        class="o_dept_kpi_header_action_btn"
        t-att-disabled="!canExportReport"
        t-on-click="exportExcelReport"
      >
        <i class="fa fa-file-excel-o"/>
        Work Report
      </button>
    </div>
  </div>

  <!-- ══ Loading ══ -->
  <div t-if="state.phase === 'loading'" class="o_dept_kpi_loading">
    <div class="o_dept_kpi_spinner"/>
    <p>Loading dashboard data…</p>
  </div>

  <!-- ══ Error ══ -->
  <div t-elif="state.phase === 'error'" class="o_dept_kpi_error">
    <i class="fa fa-exclamation-triangle"/>
    <p t-esc="state.errorMsg"/>
  </div>

  <!-- ══ Empty ══ -->
  <div t-elif="state.phase === 'empty'" class="o_dept_kpi_empty">
    <i class="fa fa-bar-chart"/>
    <p>No department evaluations found. Please select a department or create an evaluation.</p>
  </div>

  <!-- ══ Dashboard Body ══ -->
  <div t-elif="state.phase === 'done'" class="o_dept_kpi_body">
    <t t-set="report" t-value="state.data.report_dashboard || {}"/>

    <div class="o_dept_kpi_scorecards">

      <div class="o_dept_kpi_scorecard o_dept_kpi_scorecard--blue">
        <div class="o_dept_kpi_scorecard_icon">
          <i class="fa fa-tasks"/>
        </div>
        <div class="o_dept_kpi_scorecard_body">
          <div class="o_dept_kpi_scorecard_label">Total Project</div>
          <div class="o_dept_kpi_scorecard_value" t-esc="state.data.project_count || '—'"/>
        </div>
      </div>

      <div class="o_dept_kpi_scorecard o_dept_kpi_scorecard--green">
        <div class="o_dept_kpi_scorecard_icon">
          <i class="fa fa-users"/>
        </div>
        <div class="o_dept_kpi_scorecard_body">
          <div class="o_dept_kpi_scorecard_label">Total Employees</div>
          <div class="o_dept_kpi_scorecard_value" t-esc="state.data.employee_count"/>
        </div>
      </div>

      <div class="o_dept_kpi_scorecard o_dept_kpi_scorecard--amber">
        <div class="o_dept_kpi_scorecard_icon">
          <i class="fa fa-star"/>
        </div>
        <div class="o_dept_kpi_scorecard_body">
          <div class="o_dept_kpi_scorecard_label">Department KPI Score</div>
          <div class="o_dept_kpi_scorecard_value" t-esc="formatScore(state.data.dept_kpi_score)"/>
        </div>
      </div>

      <div class="o_dept_kpi_scorecard o_dept_kpi_scorecard--purple">
        <div class="o_dept_kpi_scorecard_icon">
          <i class="fa fa-calendar-check-o"/>
        </div>
        <div class="o_dept_kpi_scorecard_body">
          <div class="o_dept_kpi_scorecard_label">Period</div>
          <div class="o_dept_kpi_scorecard_value o_dept_kpi_scorecard_value--sm" t-esc="state.data.period_label || '—'"/>
        </div>
      </div>

    </div>

    <t t-if="state.data.dynamic_charts and state.data.dynamic_charts.length">
      <p t-if="state.chartErrorMsg" class="o_kpi_chart_note o_kpi_chart_runtime_error" t-esc="state.chartErrorMsg"/>
      <div class="o_dept_kpi_dynamic_grid">
        <t t-foreach="state.data.dynamic_charts" t-as="chart" t-key="chart.key">
          <div class="o_dept_kpi_chart_card" t-att-data-chart-type="chart.chart_type || 'bar'">
            <div class="o_dept_kpi_chart_header o_dept_kpi_dynamic_card_header">
              <div class="o_dept_kpi_dynamic_header_main">
                <span class="o_dept_kpi_dynamic_title">
                  <i t-att-class="chartIcon(chart.chart_type)"/>
                  <t t-esc="chart.title"/>
                </span>
                <!-- <span t-if="chart.subtitle" class="o_dept_kpi_dynamic_subtitle" t-esc="chart.subtitle"/> -->
              </div>
              <div class="o_dept_kpi_dynamic_header_badges">
                <span
                  t-if="chart.department_micro_mode === 'employee_compare'"
                  class="o_dept_kpi_mode_badge o_dept_kpi_mode_badge--employee"
                >
                  Employee Compare
                </span>
                <span
                  t-if="chart.department_micro_mode === 'department_progress'"
                  class="o_dept_kpi_mode_badge o_dept_kpi_mode_badge--department"
                >
                  Department KPI
                </span>
                <span t-if="chart.is_special_case" class="o_kpi_target_badge o_kpi_target_warn">Special Case</span>
              </div>
            </div>

            <div
              t-if="chartHasData(chart)"
              t-att-class="'o_dept_kpi_chart_body' + (chart.chart_type === 'doughnut' ? ' o_dept_kpi_chart_body--doughnut' : '')"
            >
              <div
                t-att-class="'o_dept_kpi_chart_canvas_wrap' + (chart.chart_type === 'doughnut' ? ' o_dept_kpi_chart_canvas_wrap--doughnut' : '')"
              >
                <canvas t-att-data-chart-key="chart.key" height="180"/>
                <div t-if="chart.chart_type === 'doughnut' and chart.chart_meta and chart.chart_meta.center_value" class="o_kpi_doughnut_center">
                  <div class="o_kpi_doughnut_val" t-esc="chart.chart_meta.center_value"/>
                  <div class="o_kpi_doughnut_lbl" t-esc="chart.chart_meta.center_label"/>
                </div>
              </div>
            </div>
            <p t-else="" class="o_kpi_chart_note o_kpi_muted">No chart data available for this period.</p>

            <div t-if="chart.chart_meta and chart.chart_meta.legend_rows" class="o_kpi_attendance_legend">
              <t t-foreach="chart.chart_meta.legend_rows" t-as="legendRow" t-key="legendRow_index">
                <div class="o_kpi_legend_row">
                  <span class="o_kpi_legend_label">
                    <span class="o_kpi_legend_color" t-att-style="'background-color: ' + legendRow.color"/>
                    <span t-esc="legendRow.label"/>
                  </span>
                  <span class="o_kpi_legend_value" t-esc="legendRow.value"/>
                </div>
              </t>
            </div>

            <p t-if="chart.chart_meta and chart.chart_meta.note" class="o_kpi_chart_note" t-esc="chart.chart_meta.note"/>
          </div>
        </t>
      </div>
    </t>

    <div class="performance_dashboard_form o_dept_kpi_report_shell">
      <div class="o_dept_kpi_report_content">
        <div class="pd-roster-section">
          <div class="pd-roster-header">
            <h2>Team Roster</h2>
            <button class="pd-btn-approve-all" t-att-disabled="!approvableCount || state.approvingAll" t-on-click="approveAllEvaluations">
              <i t-attf-class="fa #{state.approvingAll ? 'fa-spinner fa-spin' : 'fa-check-circle'}"/>
              <span>
                <t t-if="state.approvingAll">Approving...</t>
                <t t-else="">Approve All</t>
              </span>
            </button>
          </div>
          <t t-if="report.evaluations and report.evaluations.length > 0">
            <table class="pd-table">
              <thead>
                <tr>
                  <th>EMPLOYEE</th>
                  <th>ROLE</th>
                  <th>P2.1</th>
                  <th>P2.2</th>
                  <th>P3.1.1</th>
                  <th>P3.1.2</th>
                  <th>P3.1</th>
                  <th>RESULT</th>
                  <th>STATUS</th>
                  <th>COMMENT</th>
                  <th>ACTION</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="report.evaluations" t-as="ev" t-key="ev.id">
                  <tr>
                    <td>
                      <div class="pd-employee-cell">
                        <t t-if="ev.employee_id">
                          <img class="pd-avatar" t-att-src="'/web/image/hr.employee/' + ev.employee_id[0] + '/image_128'" t-att-alt="ev.employee_id[1]" loading="lazy"/>
                        </t>
                        <span class="pd-emp-name">
                          <a t-if="ev.employee_id" href="#" class="pd-employee-link" t-on-click.prevent="() => this.openIndividualDashboard(ev.employee_id[0], ev.id)">
                            <t t-esc="ev.employee_id[1]"/>
                          </a>
                          <t t-else="">—</t>
                        </span>
                      </div>
                    </td>
                    <td>
                      <div class="pd-emp-id">
                        <t t-esc="ev.job_id ? ev.job_id[1] : ''"/>
                      </div>
                    </td>
                    <td>
                      <div class="pd-score-cell">
                        <span class="pd-score-num" t-esc="formatReportSnapshotScore(ev.p2_1_score_raw)"/>
                      </div>
                    </td>
                    <td>
                      <div class="pd-score-cell">
                        <span class="pd-score-num" t-esc="formatReportSnapshotScore(ev.p2_2_score_raw)"/>
                      </div>
                    </td>
                    <td>
                      <div class="pd-score-cell">
                        <span class="pd-score-num" t-esc="formatReportSnapshotScore(ev.p3_individual_score)"/>
                      </div>
                    </td>
                    <td>
                      <div class="pd-score-cell">
                        <span class="pd-score-num" t-esc="formatReportSnapshotScore(ev.p3_department_score)"/>
                      </div>
                    </td>
                    <td>
                      <div class="pd-score-cell">
                        <span class="pd-score-num" t-esc="formatReportSnapshotScore(ev.p3_1_score)"/>
                      </div>
                    </td>
                    <td>
                      <t t-if="ev.performance_level === 'excellent'">
                        <span class="pd-badge badge-excellent"><i class="fa fa-star"/>EXCELLENT</span>
                      </t>
                      <t t-elif="ev.performance_level === 'pass'">
                        <span class="pd-badge badge-pass"><i class="fa fa-check"/>PASS</span>
                      </t>
                      <t t-elif="ev.performance_level === 'fail'">
                        <span class="pd-badge badge-fail"><i class="fa fa-times"/>FAIL</span>
                      </t>
                      <t t-else="">
                        <span class="pd-badge" style="background:#f3f4f6;color:#6b7280;border:1.5px solid #e5e7eb;">— N/A</span>
                      </t>
                    </td>
                    <td>
                      <span class="pd-badge">
                        <t t-if="ev.state === 'self_evaluation'">
                          <i class="fa fa-clock-o"/>SELF EVAL
                        </t>
                        <t t-elif="ev.state === 'manager_evaluating'">
                          <i class="fa fa-spinner fa-spin pd-manager-eval-status"/>
                          <span class="pd-manager-eval-status">MANAGER EVALUATING</span>
                        </t>
                        <t t-elif="ev.state === 'completed'">
                          <i class="fa fa-check-circle pd-completed-status"/>
                          <span class="pd-completed-status">COMPLETED</span>
                        </t>
                        <t t-elif="ev.state === 'cancel'">
                          <i class="fa fa-ban"/>
                          <span class="pd-cancel-status">CANCELLED</span>
                        </t>
                      </span>
                    </td>
                    <td>
                      <button
                        t-attf-class="pd-comment-btn #{ev.comment_count ? 'is-active' : 'is-empty'}"
                        t-att-disabled="!ev.comment_count"
                        t-on-click="() => this.openCommentPopup(ev)"
                      >
                        <t t-esc="formatCommentCount(ev.comment_count)"/>
                      </button>
                    </td>
                    <td>
                      <button t-attf-class="pd-action-btn #{ev.state === 'manager_evaluating' ? 'pd-btn-attention' : ''}" t-on-click="() => this.openEvaluation(ev.id)">
                        <i class="fa fa-chevron-right"/>
                      </button>
                    </td>
                  </tr>
                </t>
              </tbody>
            </table>
          </t>
          <t t-else="">
            <div class="pd-empty-state">
              <i class="fa fa-users"/>
              <p>No evaluations found for this period.</p>
            </div>
          </t>
        </div>
      </div>
    </div>

    <div class="o_dept_kpi_chart_row o_dept_kpi_chart_row--1col" style="margin-top: 20px;">
      <div class="o_dept_kpi_chart_card">
        <div class="o_dept_kpi_chart_header">
          <div class="o_dept_kpi_chart_title">
            <span class="o_dept_kpi_chart_dot o_dept_kpi_chart_dot--blue"/>
            Detailed Evaluation Log
          </div>
          <span class="o_dept_kpi_chart_badge o_dept_kpi_chart_badge--blue">Quantitative</span>
        </div>
        <div class="o_dept_kpi_chart_body">
          <div class="o_kpi_table_wrapper">
            <table class="o_kpi_table" t-if="state.data.quantitative_table and state.data.quantitative_table.length">
              <thead>
                <tr>
                  <th>KPI Measure</th>
                  <th>Target</th>
                  <th>Actual</th>
                  <th>Variance</th>
                  <th>Status</th>
                  <th>Score</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="state.data.quantitative_table" t-as="row" t-key="row_index">
                  <tr>
                    <td class="o_kpi_table_name" t-esc="row.name"/>
                    <td>
                      <span t-if="row.linear_direction === 'higher_better'" class="fa fa-arrow-up text-success"/>
                      <span t-if="row.linear_direction === 'lower_better'" class="fa fa-arrow-down text-danger"/>
                      <span class="ms-1" t-esc="row.target"/>
                    </td>
                    <td t-esc="row.actual"/>
                    <td><span t-att-class="varianceClass(row)" t-esc="formatVariance(row)"/></td>
                    <td><span t-att-class="statusClass(row)" t-esc="statusText(row)"/></td>
                    <td><b t-esc="formatScore(row.final_score)"/></td>
                  </tr>
                </t>
              </tbody>
            </table>
            <p t-else="" class="o_dept_kpi_empty">No quantitative KPI data available.</p>
          </div>
        </div>
      </div>
    </div>

    <div
      t-if="state.commentModalOpen"
      class="o_dept_comment_modal_backdrop"
      t-on-click="closeCommentPopup"
    >
      <div
        class="o_dept_comment_modal"
        role="dialog"
        aria-modal="true"
        t-on-click.stop=""
      >
        <div class="o_dept_comment_modal_header">
          <div>
            <div class="o_dept_comment_modal_title">KPI Comments</div>
            <div class="o_dept_comment_modal_subtitle">
              <t t-esc="state.commentModalEmployeeName || '—'"/>
              <t t-if="state.commentModalEvaluationName">
                <span>•</span>
                <t t-esc="state.commentModalEvaluationName"/>
              </t>
            </div>
          </div>
          <button type="button" class="o_dept_comment_modal_close" t-on-click="closeCommentPopup">
            <i class="fa fa-times"/>
          </button>
        </div>

        <div class="o_dept_comment_modal_body">
          <div t-if="state.commentModalLoading" class="o_dept_comment_modal_loading">
            <div class="o_dept_kpi_spinner"/>
            <p>Loading comments…</p>
          </div>
          <div t-elif="state.commentModalRows.length" class="o_dept_comment_modal_table_wrap">
            <table class="o_dept_comment_modal_table">
              <thead>
                <tr>
                  <th>KPI</th>
                  <th>Employee Comment</th>
                  <th>Manager Comment</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="state.commentModalRows" t-as="row" t-key="row.id">
                  <tr>
                    <td class="o_dept_comment_modal_kpi" t-esc="row.kpi_title"/>
                    <td t-esc="commentText(row.employee_comment)"/>
                    <td t-esc="commentText(row.manager_comment)"/>
                  </tr>
                </t>
              </tbody>
            </table>
          </div>
          <div t-else="" class="o_dept_comment_modal_empty">
            <i class="fa fa-commenting-o"/>
            <p>No comments available for this evaluation.</p>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /o_dept_kpi_body -->

</div><!-- /o_dept_kpi_page -->
</t>

</templates>
