<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="custom_adecsol_hr_performance_evaluator.PerformanceDashboard">
        <div class="performance_dashboard_form">

            <div class="pd-header">
                <div class="pd-header-left">
                    <h1 class="pd-title">
                        <t t-esc="state.departmentName"/>
                    </h1>
                    <p class="pd-subtitle">Employee KPI Analytics</p>
                </div>

                <div class="pd-header-right">
                    <div class="pd-header-toolbar">
                        <div class="pd-header-fields">
                            <div class="pd-header-field-group">
                                <label>Start</label>
                                <input type="date" t-att-value="state.startDate" t-on-change="onStartDateChange"/>
                            </div>
                            <div class="pd-header-field-group">
                                <label>End</label>
                                <input type="date" t-att-value="state.endDate" t-on-change="onEndDateChange"/>
                            </div>
                            <div class="pd-header-field-group">
                                <label>Deadline</label>
                                <input type="date" t-att-value="state.deadline" t-on-change="onDeadlineChange"/>
                            </div>
                        </div>

                        <!-- <div class="pd-header-active-toggle">
                            <span class="pd-active-label">ACTIVE</span>
                            <label class="pd-toggle-switch">
                                <input type="checkbox" t-att-checked="state.active ? 'checked' : undefined" t-on-change="onActiveChange"/>
                                <span class="pd-toggle-slider"/>
                            </label>
                        </div> -->
                    </div>

                    <button class="pd-btn-export" t-on-click="exportExcelReport">
                        <i class="fa fa-file-excel-o"/>
                        Work Report
                    </button>
                </div>
            </div>
            <div class="pd-wrapper">

                <!-- ══ HEADER ══ -->

                <div class="pd-scorecards">
                    <div class="pd-scorecard pd-scorecard--blue">
                        <div class="pd-scorecard-icon">
                            <i class="fa fa-tachometer"/>
                        </div>
                        <div class="pd-scorecard-body">
                            <div class="pd-scorecard-label">Average Score</div>
                            <div class="pd-scorecard-value">
                                <t t-esc="formatScore(state.chartData ? (state.chartData.avg_score || 0) : 0)"/>
                            </div>
                        </div>
                    </div>
                    <div class="pd-scorecard pd-scorecard--green">
                        <div class="pd-scorecard-icon">
                            <i class="fa fa-check-circle"/>
                        </div>
                        <div class="pd-scorecard-body">
                            <div class="pd-scorecard-label">Pass Rate</div>
                            <div class="pd-scorecard-value">
                                <t t-esc="state.chartData ? (state.chartData.pass_count || 0) : 0"/>
                                <span class="pd-scorecard-unit"> / <t t-esc="state.chartData ? (state.chartData.total_employees || 0) : 0"/></span>
                            </div>
                        </div>
                    </div>
                    <div class="pd-scorecard pd-scorecard--amber">
                        <div class="pd-scorecard-icon">
                            <i class="fa fa-users"/>
                        </div>
                        <div class="pd-scorecard-body">
                            <div class="pd-scorecard-label">Total Employees</div>
                            <div class="pd-scorecard-value">
                                <t t-esc="state.chartData ? (state.chartData.total_employees || 0) : 0"/>
                            </div>
                        </div>
                    </div>
                    <div class="pd-scorecard pd-scorecard--purple">
                        <div class="pd-scorecard-icon">
                            <i class="fa fa-calendar-check-o"/>
                        </div>
                        <div class="pd-scorecard-body">
                            <div class="pd-scorecard-label">Period</div>
                            <div class="pd-scorecard-value pd-scorecard-value--sm">
                                <t t-esc="state.periodLabel"/>
                            </div>
                        </div>
                    </div>
                </div>


                <t t-if="state.chartData and state.chartData.report_sections">
                    <t t-foreach="state.chartData.report_sections" t-as="section" t-key="section.key">
                        <div
                            t-if="section.section_type === 'chart_row'"
                            t-attf-class="pd-chart-row pd-chart-row--#{section.layout}"
                        >
                            <t t-foreach="section.items" t-as="item" t-key="item.key">
                                <div class="pd-chart-card">
                                    <div class="pd-chart-header">
                                        <div class="pd-chart-title">
                                            <span t-attf-class="pd-chart-dot pd-chart-dot--#{item.dot_tone}"/>
                                            <span t-esc="item.title"/>
                                        </div>
                                        <span t-attf-class="pd-chart-badge pd-chart-badge--#{item.badge_tone}" t-esc="item.badge"/>
                                    </div>
                                    <div t-attf-class="pd-chart-body#{item.measure_field === 'report_attendance' ? ' pd-chart-body--doughnut' : ''}">
                                        <canvas t-att-data-section-key="item.key"/>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <t t-if="section.section_type === 'qualitative_grid' and section.charts and section.charts.length">
                            <div class="pd-section-title">
                                <i class="fa fa-star-o"/>
                                <span t-esc="section.title"/>
                            </div>
                            <div class="pd-chart-row pd-chart-row--qual">
                                <t t-foreach="section.charts" t-as="qc" t-key="qc_index">
                                    <div class="pd-chart-card">
                                        <div class="pd-chart-header">
                                            <div class="pd-chart-title">
                                                <span class="pd-chart-dot pd-chart-dot--purple"/>
                                                <t t-esc="qc.kpi_name"/>
                                            </div>
                                        </div>
                                        <div class="pd-chart-body pd-chart-body--doughnut">
                                            <canvas t-att-id="section.key + '-qual-chart-' + qc_index"/>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </t>
                </t>

                <div class="pd-roster-section">
                    <div class="pd-roster-header">
                        <h2>Team Roster</h2>
                        <button class="pd-btn-approve-all" t-att-disabled="!approvableCount || state.approvingAll" t-on-click="approveAllEvaluations">
                            <i t-attf-class="fa #{state.approvingAll ? 'fa-spinner fa-spin' : 'fa-check-circle'}"/>
                            <span>
                                <t t-if="state.approvingAll">Approving...</t>
                                <t t-else="">Approve All</t>
                            </span>
                        </button>
                    </div>
                    <t t-if="state.chartData and state.chartData.evaluations and state.chartData.evaluations.length > 0">
                        <table class="pd-table">
                            <thead>
                                <tr>
                                    <th>EMPLOYEE</th>
                                    <th>ROLE</th>
                                    <th>INDIVIDUAL KPI SCORE</th>
                                    <th>RESULT</th>
                                    <th>STATUS</th>
                                    <th>ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.chartData.evaluations" t-as="ev" t-key="ev.id">
                                    <tr>
                                        <td>
                                            <div class="pd-employee-cell">
                                                <t t-if="ev.employee_id">
                                                    <img class="pd-avatar" t-att-src="'/web/image/hr.employee/' + ev.employee_id[0] + '/image_128'" t-att-alt="ev.employee_id[1]" loading="lazy"/>
                                                </t>
                                                <span class="pd-emp-name">
                                                    <a href="#" class="pd-employee-link" t-on-click.prevent="() => this.openIndividualDashboard(ev.employee_id[0], ev.id)">
                                                        <t t-esc="ev.employee_id[1]"/>
                                                    </a>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="pd-emp-id">
                                                <t t-esc="ev.job_id ? ev.job_id[1] : ''"/>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="pd-score-cell">
                                                <span class="pd-score-num">
                                                    <t t-esc="formatScore(ev.total_p3_individual || 0, 1)"/>
                                                </span>
                                                <div class="pd-progress-bar-wrap">
                                                    <div class="pd-progress-bar-fill" t-att-style="'width:' + scorePct(ev.total_p3_individual || 0) + '%'"/>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <t t-if="ev.performance_level === 'excellent'">
                                                <span class="pd-badge badge-excellent">
                                                    <i class="fa fa-star"/>
                                                    EXCELLENT</span>
                                            </t>
                                            <t t-elif="ev.performance_level === 'pass'">
                                                <span class="pd-badge badge-pass">
                                                    <i class="fa fa-check"/>
                                                    PASS</span>
                                            </t>
                                            <t t-elif="ev.performance_level === 'fail'">
                                                <span class="pd-badge badge-fail">
                                                    <i class="fa fa-times"/>
                                                    FAIL</span>
                                            </t>
                                            <t t-else="">
                                                <span class="pd-badge" style="background:#f3f4f6;color:#6b7280;border:1.5px solid #e5e7eb;">— N/A</span>
                                            </t>
                                        </td>
                                        <td>
                                            <span class="pd-badge">
                                                <t t-if="ev.state === 'self_evaluation'">
                                                    <i class="fa fa-clock-o"/>
                                                    SELF EVAL</t>
                                                <t t-elif="ev.state === 'manager_evaluating'">
                                                    <i class="fa fa-spinner fa-spin pd-manager-eval-status"/>
                                                    <span class="pd-manager-eval-status">MANAGER EVALUATING</span>
                                                </t>
                                                <t t-elif="ev.state === 'completed'">
                                                    <i class="fa fa-check-circle pd-completed-status"/>
                                                    <span class="pd-completed-status">COMPLETED</span>
                                                </t>
                                                <t t-elif="ev.state === 'cancel'">
                                                    <i class="fa fa-ban"/>
                                                    <span class="pd-cancel-status">CANCELLED</span>
                                                </t>
                                            </span>
                                        </td>
                                        <td>
                                            <button t-attf-class="pd-action-btn #{ev.state === 'manager_evaluating' ? 'pd-btn-attention' : ''}" t-on-click="() => this.openEvaluation(ev.id)">
                                                <i class="fa fa-chevron-right"/>
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-else="">
                        <div class="pd-empty-state">
                            <i class="fa fa-users"/>
                            <p>No evaluations found for this period.</p>
                        </div>
                    </t>
                </div>

            </div>            <!--
            /pd-wrapper -->
        </div>
    </t>

</templates>
