<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="performance_evaluator.KpiTreeDashboard">
<div class="o_kpi_tree_page">

      <!-- ══ Header Bar ══ -->
  <div class="o_kpi_tree_header">
    <div class="o_kpi_tree_brand">
      <i class="fa fa-sitemap"/>
      <span>KPI Tree Dashboard</span>
    </div>

    <div class="o_kpi_tree_controls">
          <!-- Period Selector -->
      <div class="o_kpi_tree_control_group" t-if="!state.loading and state.data and state.data.available_periods.length">
        <label class="o_kpi_tree_label">Period:</label>
        <select class="o_kpi_tree_select" t-on-change="onPeriodChange">
          <t t-foreach="state.data.available_periods" t-as="p" t-key="p_index">
            <option
              t-att-value="p_index"
              t-att-selected="state.selectedPeriod and state.selectedPeriod.start === p.start"
              t-esc="p.label"
            />
          </t>
        </select>
      </div>
    </div>
  </div>

      <!-- ══ Loading State ══ -->
  <div t-if="state.loading" class="o_kpi_tree_body">
        <!-- Skeleton 6 cards -->
    <div t-if="hasWidget('tree_metrics')" class="o_kpi_tree_metric_row">
      <t t-foreach="[1,2,3,4,5]" t-as="i" t-key="i">
        <div class="o_kpi_tree_metric_card skeleton">
          <div class="sk-title"/>
          <div class="sk-value"/>
          <div class="sk-sub"/>
        </div>
      </t>
    </div>
        <!-- Skeleton tree placeholder -->
    <div class="o_kpi_tree_main">
      <div class="o_kpi_tree_svg_wrap skeleton-tree">
        <div class="sk-tree-placeholder">
          <i class="fa fa-sitemap fa-3x"/>
          <p>Loading KPI data...</p>
        </div>
      </div>
    </div>
  </div>

      <!-- ══ Dashboard Body ══ -->
  <div t-elif="!state.loading and state.data" class="o_kpi_tree_body">

        <!-- ── 6 Metric Cards ── -->
    <div class="o_kpi_tree_metric_row">

          <!-- Card 1: KPI Công ty (REAL DATA) -->
      <div class="o_kpi_tree_metric_card card-blue" t-on-click="selectCompanyNode">
        <div class="metric-icon"><i class="fa fa-globe"/></div>
        <div class="metric-body">
          <div class="metric-label">Company KPI</div>
          <div class="metric-value" t-esc="formatScore(state.data.company.dept_kpi_score)"/>
          <div class="metric-sub">Average department KPI</div>
        </div>
      </div>

          <!-- Card 2: KPI Tài chính -->
          <!-- <div class="o_kpi_tree_metric_card card-amber" t-on-click="selectCompanyNode">
        <div class="metric-icon"><i class="fa fa-usd"/></div>
        <div class="metric-body">
          <div class="metric-label">KPI Tài chính</div>
          <div class="metric-value">—</div>
          <div class="metric-sub">Không có dữ liệu</div>
        </div>
      </div> -->

          <!-- Card 3: KPI Hoạt động (REAL DATA — số nhân viên đạt + xuất sắc) -->
      <div class="o_kpi_tree_metric_card card-green" t-on-click="selectCompanyNode">
        <div class="metric-icon"><i class="fa fa-check-circle"/></div>
        <div class="metric-body">
          <div class="metric-label">EMPLOYEES MEETING TARGETS</div>
          <div class="metric-value">
              <t t-esc="state.data.company.pass_employee_count"/> / <t t-esc="state.data.company.total_employees"/>
          </div>
          <div class="metric-sub">Employees rated pass &amp; excellent</div>
        </div>
      </div>

          <!-- Card 4: KPI chưa đạt (REAL DATA) -->
      <div class="o_kpi_tree_metric_card card-red" t-on-click="selectCompanyNode">
        <div class="metric-icon"><i class="fa fa-exclamation-triangle"/></div>
        <div class="metric-body">
          <div class="metric-label">Underperforming KPIs</div>
          <div class="metric-value" t-esc="riskLineCount()"/>
          <div class="metric-sub">Low-scoring KPIs</div>
        </div>
      </div>

          <!-- Card 5: KPI Thiếu dữ liệu (REAL DATA) -->
      <div class="o_kpi_tree_metric_card card-purple" t-on-click="selectCompanyNode">
        <div class="metric-icon"><i class="fa fa-database"/></div>
        <div class="metric-body">
          <div class="metric-label">KPIs Missing Data</div>
          <div class="metric-value" t-esc="missingDataLineCount()"/>
          <div class="metric-sub">KPIs not entered yet</div>
        </div>
      </div>

    </div>

        <!-- ── Main: Tree + Detail Panel ── -->
    <div class="o_kpi_tree_main">

          <!-- ── SVG Tree ── -->
      <div
        t-if="hasWidget('tree_main') and state.data.departments.length > 0"
        class="o_kpi_tree_svg_wrap"
      >
        <div t-ref="d3_container" class="d3-kpi-container"></div>
      </div>

          <!-- Empty State -->
      <div t-else="" class="empty-state">
        <i class="fa fa-sitemap fa-3x"/>
        <p>No KPI data is available for this period.</p>
        <p>Create an evaluation from the Department KPI Template menu or select another period.</p>
      </div>

          <!-- ── Detail Panel (bên phải) ── -->
      <div t-if="hasWidget('tree_main') and state.selectedNode" class="o_kpi_tree_detail_panel">
        <div class="panel-header">
          <span class="panel-close" t-on-click="closePanel"><i class="fa fa-times"/></span>

              <!-- type = company -->
          <t t-if="state.selectedNode.type === 'company'">
            <div class="panel-title"><i class="fa fa-globe"/> Company</div>
            <div class="panel-sub">Company-wide overview</div>
          </t>

              <!-- type = dept -->
          <t t-elif="state.selectedNode.type === 'dept'">
            <div class="panel-title"><i class="fa fa-building"/> <t t-esc="state.selectedNode.data.name"/></div>
            <div class="panel-sub" t-esc="state.selectedNode.data.manager_name or 'No manager assigned'"/>
          </t>

              <!-- type = emp -->
          <t t-elif="state.selectedNode.type === 'emp'">
            <div class="panel-avatar">
              <img t-att-src="state.selectedNode.data.avatar_url"
                   t-att-alt="state.selectedNode.data.name"
                   onerror="this.style.display='none'"
              />
            </div>
            <div class="panel-title" t-esc="state.selectedNode.data.name"/>
            <div class="panel-sub" t-esc="state.selectedNode.data.job or ''"/>
          </t>
        </div>

        <div class="panel-body">

              <!-- ── Company detail ── -->
          <t t-if="state.selectedNode.type === 'company'">
            <div class="panel-metric">
              <span class="pm-label">Average department KPI:</span>
              <span class="pm-value" t-esc="formatScore(state.selectedNode.data.dept_kpi_score)"/>
            </div>
            <div class="panel-metric">
              <span class="pm-label">Total employees:</span>
              <span class="pm-value" t-esc="state.selectedNode.data.total_employees"/>
            </div>
            <div class="panel-metric">
              <span class="pm-label">Departments:</span>
              <span class="pm-value" t-esc="state.selectedNode.data.total_depts"/>
            </div>
            <div class="panel-metric">
              <span class="pm-label">Employees passing:</span>
              <span class="pm-value" t-esc="state.selectedNode.data.pass_employee_count"/>
            </div>
                <!-- <div class="panel-note">* Trend theo quý sẽ cập nhật sau</div> -->
          </t>

              <!-- ── Dept detail ── -->
          <t t-elif="state.selectedNode.type === 'dept'">
            <div class="panel-metric">
              <span class="pm-label">Department KPI:</span>
              <span class="pm-value" t-esc="formatScore(state.selectedNode.data.dept_kpi_score)"/>
            </div>
            <div class="panel-metric">
              <span class="pm-label">Employees:</span>
              <span class="pm-value" t-esc="state.selectedNode.data.employee_count"/>
            </div>
                <!-- <div class="panel-note">Chưa có dữ liệu trend cho kỳ này</div> -->
          </t>

              <!-- ── Employee detail ── -->
          <t t-elif="state.selectedNode.type === 'emp'">
            <div class="panel-metric">
              <span class="pm-label">Individual KPI:</span>
              <span class="pm-value highlight" t-esc="formatScore(state.selectedNode.data.total_p3_individual)"/>
            </div>
            <div class="panel-metric">
              <span class="pm-label">Department KPI:</span>
              <span class="pm-value" t-esc="formatScore(state.selectedNode.data.dept_kpi_score)"/>
            </div>
            <div class="panel-metric">
              <span class="pm-label">Total P2.1:</span>
              <span class="pm-value" t-esc="formatScore(state.selectedNode.data.total_p2_1)"/>
            </div>
            <div class="panel-metric">
              <span class="pm-label">Total P2.2:</span>
              <span class="pm-value" t-esc="formatScore(state.selectedNode.data.total_p2_2)"/>
            </div>
            <div class="panel-metric">
              <span class="pm-label">Result:</span>
              <span t-att-class="levelBadgeClass(state.selectedNode.data.performance_level)"
                    t-esc="state.selectedNode.data.performance_level || 'fail'"/>
            </div>
                <!-- <div class="panel-note">Chưa có dữ liệu trend cho kỳ này</div> -->
          </t>

        </div>
      </div>

    </div><!--
        /o_kpi_tree_main -->

        <!-- ── 4 Panels phía dưới ── -->
    <div class="o_kpi_tree_panels">

          <!-- Panel 1: Top KPI rủi ro (REAL DATA) -->
      <div t-if="hasWidget('tree_risk_kpis')" class="o_kpi_tree_panel">
        <div class="panel-head"><i class="fa fa-exclamation-triangle"/> Top underperforming KPIs</div>
        <t t-if="riskLineCount() > 0">
          <t t-foreach="topRiskLines()" t-as="item" t-key="(item.source_type || 'employee') + '_' + (item.line_id || item_index)">
            <div class="risk-row risk-row-clickable" t-on-click="() => this.openRiskLine(item)">
              <div class="risk-info">
                <div class="issue-title-line">
                  <span t-att-class="sourceBadgeClass(item)" t-esc="item.source_label || 'Individual'"/>
                  <span class="risk-name" t-esc="item.kpi_name"/>
                </div>
                <span class="risk-meta" t-esc="issueMeta(item)"/>
              </div>
              <div class="risk-right">
                <span class="risk-score" t-esc="formatScore(item.score)"/>
                <span t-att-class="levelBadgeClass(item.level)" t-esc="item.level"/>
              </div>
            </div>
          </t>
          <button t-if="riskLineCount() > 5"
                  type="button"
                  class="risk-view-all-btn"
                  t-on-click="openRiskModal">
            View all (<t t-esc="riskLineCount()"/>)
          </button>
        </t>
        <div t-else="" class="panel-empty">No risky KPIs</div>
      </div>

          <!-- Panel 2: Đóng góp phòng ban theo điểm KPI phòng ban trong kỳ -->
      <div t-if="hasWidget('tree_department_contribution')" class="o_kpi_tree_panel">
        <div class="panel-head"><i class="fa fa-building"/> Department contribution</div>
        <t t-foreach="state.data.departments" t-as="dept" t-key="dept.id">
          <div class="dept-row">
            <div class="dept-name" t-esc="dept.name"/>
            <div class="dept-bar-wrap">
              <div class="dept-bar"
                t-att-style="'width:' + scoreBarWidth(dept.dept_kpi_score) + '%;'">
              </div>
            </div>
            <div class="dept-score" t-esc="formatScore(dept.dept_kpi_score)"/>
          </div>
        </t>
      </div>

          <!-- Panel 3: KPI thiếu dữ liệu (REAL DATA) -->
      <div t-if="hasWidget('tree_missing_data')" class="o_kpi_tree_panel">
        <div class="panel-head"><i class="fa fa-database"/> KPIs Missing Data</div>
        <t t-if="missingDataLineCount() > 0">
          <t t-foreach="topMissingDataLines()" t-as="item" t-key="(item.source_type || 'employee') + '_' + (item.line_id || item_index)">
            <div class="miss-row miss-row-clickable" t-on-click="() => this.openMissingDataLine(item)">
              <div class="miss-info">
                <div class="issue-title-line">
                  <span t-att-class="sourceBadgeClass(item)" t-esc="item.source_label || 'Individual'"/>
                  <span class="miss-name" t-esc="item.kpi_name"/>
                </div>
                <span class="miss-meta" t-esc="issueMeta(item)"/>
              </div>
              <span class="tag-missing">Missing data</span>
            </div>
          </t>
          <button t-if="missingDataLineCount() > 5"
                  type="button"
                  class="missing-view-all-btn"
                  t-on-click="openMissingDataModal">
            View all (<t t-esc="missingDataLineCount()"/>)
          </button>
        </t>
        <div t-else="" class="panel-empty">All KPIs have data ✓</div>
      </div>

          <!-- Panel 4: Top đánh giá không đạt -->
      <div t-if="hasWidget('tree_failed_evaluations')" class="o_kpi_tree_panel">
        <div class="panel-head"><i class="fa fa-times-circle"/> Top failed evaluations</div>
        <t t-if="failedEvaluationCount() > 0">
          <t t-foreach="topFailedEvaluations()" t-as="item" t-key="(item.source_type || 'employee') + '_' + (item.record_id || item_index)">
            <div class="risk-row risk-row-clickable" t-on-click="() => this.openFailedEvaluation(item)">
              <div class="risk-info">
                <div class="issue-title-line">
                  <span t-att-class="sourceBadgeClass(item)" t-esc="item.source_label || 'Individual'"/>
                  <span class="risk-name" t-esc="failedEvaluationTitle(item)"/>
                </div>
                <span class="risk-meta" t-esc="issueMeta(item)"/>
              </div>
              <div class="risk-right">
                <span class="risk-score" t-esc="formatScore(item.score)"/>
                <span t-att-class="levelBadgeClass(item.level)" t-esc="item.score_label || item.level"/>
              </div>
            </div>
          </t>
          <button t-if="failedEvaluationCount() > 5"
                  type="button"
                  class="risk-view-all-btn"
                  t-on-click="openFailedEvaluationModal">
            View all (<t t-esc="failedEvaluationCount()"/>)
          </button>
        </t>
        <div t-else="" class="panel-empty">No failed evaluations</div>
      </div>

    </div><!--
        /o_kpi_tree_panels -->

    <div t-if="state.showRiskModal" class="o_kpi_tree_modal_backdrop">
      <div class="o_kpi_tree_modal">
        <div class="o_kpi_tree_modal_header">
          <div>
            <div class="modal-title">All risky KPIs</div>
            <div class="modal-subtitle"><t t-esc="riskLineCount()"/> KPI lines are failing in this period</div>
          </div>
          <button type="button" class="modal-close-btn" t-on-click="closeRiskModal">
            <i class="fa fa-times"/>
          </button>
        </div>
        <div class="o_kpi_tree_modal_body">
          <t t-foreach="allRiskLines()" t-as="item" t-key="(item.source_type || 'employee') + '_' + (item.line_id || item_index)">
            <div class="risk-modal-row" t-on-click="() => this.openRiskLine(item)">
              <div class="risk-modal-main">
                <div class="issue-title-line">
                  <span t-att-class="sourceBadgeClass(item)" t-esc="item.source_label || 'Individual'"/>
                  <span class="risk-name" t-esc="item.kpi_name"/>
                </div>
                <span class="risk-meta" t-esc="issueMeta(item)"/>
              </div>
              <div class="risk-modal-right">
                <span class="risk-score" t-esc="formatScore(item.score)"/>
                <span t-att-class="levelBadgeClass(item.level)" t-esc="item.level"/>
              </div>
            </div>
          </t>
        </div>
      </div>
    </div>

    <div t-if="state.showMissingDataModal" class="o_kpi_tree_modal_backdrop">
      <div class="o_kpi_tree_modal">
        <div class="o_kpi_tree_modal_header">
          <div>
            <div class="modal-title">All KPIs missing data</div>
            <div class="modal-subtitle"><t t-esc="missingDataLineCount()"/> KPI lines need data or configuration updates</div>
          </div>
          <button type="button" class="modal-close-btn" t-on-click="closeMissingDataModal">
            <i class="fa fa-times"/>
          </button>
        </div>
        <div class="o_kpi_tree_modal_body">
          <t t-foreach="allMissingDataLines()" t-as="item" t-key="(item.source_type || 'employee') + '_' + (item.line_id || item_index)">
            <div class="missing-modal-row" t-on-click="() => this.openMissingDataLine(item)">
              <div class="missing-modal-main">
                <div class="issue-title-line">
                  <span t-att-class="sourceBadgeClass(item)" t-esc="item.source_label || 'Individual'"/>
                  <span class="miss-name" t-esc="item.kpi_name"/>
                </div>
                <span class="miss-meta" t-esc="issueMeta(item)"/>
              </div>
              <div class="missing-modal-right">
                <span class="tag-missing">Missing data</span>
              </div>
            </div>
          </t>
        </div>
      </div>
    </div>

    <div t-if="state.showFailedEvaluationModal" class="o_kpi_tree_modal_backdrop">
      <div class="o_kpi_tree_modal">
        <div class="o_kpi_tree_modal_header">
          <div>
            <div class="modal-title">All failed evaluations</div>
            <div class="modal-subtitle"><t t-esc="failedEvaluationCount()"/> evaluations are below threshold in this period</div>
          </div>
          <button type="button" class="modal-close-btn" t-on-click="closeFailedEvaluationModal">
            <i class="fa fa-times"/>
          </button>
        </div>
        <div class="o_kpi_tree_modal_body">
          <t t-foreach="allFailedEvaluations()" t-as="item" t-key="(item.source_type || 'employee') + '_' + (item.record_id || item_index)">
            <div class="risk-modal-row" t-on-click="() => this.openFailedEvaluation(item)">
              <div class="risk-modal-main">
                <div class="issue-title-line">
                  <span t-att-class="sourceBadgeClass(item)" t-esc="item.source_label || 'Individual'"/>
                  <span class="risk-name" t-esc="failedEvaluationTitle(item)"/>
                </div>
                <span class="risk-meta" t-esc="issueMeta(item)"/>
              </div>
              <div class="risk-modal-right">
                <span class="risk-score" t-esc="formatScore(item.score)"/>
                <span t-att-class="levelBadgeClass(item.level)" t-esc="item.score_label || item.level"/>
              </div>
            </div>
          </t>
        </div>
      </div>
    </div>

  </div><!--
      /o_kpi_tree_body -->

      <!-- ══ Empty (no data at all) ══ -->
  <div t-elif="!state.loading and !state.data" class="o_kpi_tree_body">
    <div class="empty-state">
      <i class="fa fa-sitemap fa-3x"/>
      <p>Unable to load KPI data.</p>
      <p>Please check the connection or contact your administrator.</p>
    </div>
  </div>

</div><!--
    /o_kpi_tree_page -->
</t>

</templates>
