<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="custom_adecsol_hr_performance_evaluator.KpiStepTableEditor">
        <div class="o_kpi_step_table_editor">
            <t t-if="props.readonly">
                <table class="table table-sm table-bordered mb-0">
                    <thead>
                        <tr>
                            <th>Từ</th>
                            <th>Đến</th>
                            <th>Điểm</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="readonlyRows" t-as="row" t-key="row.from + '_' + row.to + '_' + row.score">
                            <td><t t-esc="row.from"/></td>
                            <td><t t-esc="row.unbounded ? 'Không giới hạn' : row.to"/></td>
                            <td><t t-esc="row.score"/></td>
                        </tr>
                    </tbody>
                </table>
            </t>
            <t t-else="">
                <div class="mb-2">
                    <button type="button" class="btn btn-secondary btn-sm" t-on-click="addRow">Thêm bậc</button>
                </div>
                <table class="table table-sm table-bordered align-middle mb-2">
                    <thead>
                        <tr>
                            <th>Từ</th>
                            <th>Đến</th>
                            <th>Điểm</th>
                            <!-- <th>Mở</th> -->
                            <th/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.rows" t-as="row" t-key="row._rowId">
                            <td>
                                <input type="number" step="any" class="form-control"
                                    t-att-data-row-id="row._rowId"
                                    data-field="from"
                                    t-att-value="row.from"
                                    t-on-input="onInput"/>
                            </td>
                            <td>
                                <!-- <input type="number" step="any" class="form-control"
                                    t-att-data-index="row_index"
                                    data-field="to"
                                    t-att-disabled="row.unbounded"
                                    t-att-value="row.unbounded ? '' : row.to"
                                    t-on-input="onInput"/> -->
                                <input type="number" step="any" class="form-control"
                                    t-att-data-row-id="row._rowId"
                                    data-field="to"
                                    t-att-value="row.unbounded ? '' : row.to"
                                    t-on-input="onInput"/>
                            </td>
                            <td>
                                <input type="number" step="any" class="form-control"
                                    t-att-data-row-id="row._rowId"
                                    data-field="score"
                                    t-att-value="row.score"
                                    t-on-input="onInput"/>
                            </td>
                            <!-- <td class="text-center">
                                <input type="checkbox"
                                    t-att-data-index="row_index"
                                    t-att-checked="row.unbounded"
                                    t-on-change="onToggleUnbounded"/>
                            </td> -->
                            <td class="text-center">
                                <button type="button" class="btn btn-link text-danger p-0"
                                    t-att-data-row-id="row._rowId"
                                    t-on-click="removeRow">
                                    <i class="fa fa-trash"/>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="text-danger" t-if="state.error">
                    <t t-esc="state.error"/>
                </div>
            </t>
        </div>
    </t>
</templates>
