<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="performance_evaluator.KpiDashboardStandalone">
    <div class="o_kpi_dashboard_page" t-ref="dashboardRoot">

      <!-- Selector Bar -->
      <div class="o_kpi_selector_bar">
        <div class="o_kpi_selector_left">
          <i class="fa fa-tachometer o_kpi_selector_icon"/>
          <span class="o_kpi_selector_title">Individual Performance Dashboard</span>
        </div>
        <div class="o_kpi_selector_right">
          <!-- Bộ lọc Department & Employee (Chỉ dành cho Manager) -->
          <t t-if="state.isManager || state.isHR || state.isAdmin">
            <!-- Chọn phòng ban -->
            <label class="o_kpi_selector_label">Department:</label>
            <select class="o_kpi_selector_select o_kpi_dept_select" t-on-change="onSelectDepartment">
              <option t-if="state.isHR || state.isAdmin" value="">All Departments</option>
              <t t-foreach="state.departments" t-as="dept" t-key="dept.id">
                <option t-att-value="dept.id" t-att-selected="dept.id === state.selectedDepartmentId" t-esc="dept.name"/>
              </t>
            </select>

            <!-- Chọn nhân viên (Data đã được lọc) -->
            <label class="o_kpi_selector_label">Employee:</label>
            <select class="o_kpi_selector_select o_kpi_employee_select" t-on-change="onSelectEmployee">
              <t t-foreach="state.filteredEmployees" t-as="emp" t-key="emp.id">
                <option t-att-value="emp.id" t-att-selected="emp.id === state.selectedEmployeeId" t-esc="emp.name"/>
              </t>
            </select>
          </t>

          <!-- Chọn kỳ đánh giá (Hiển thị nếu nhân viên đó có dữ liệu) -->
          <t t-if="state.evaluations.length">
            <label class="o_kpi_selector_label">Evaluation:</label>
            <select class="o_kpi_selector_select o_kpi_eval_select" t-on-change="onSelectEval">
              <t t-foreach="state.evaluations" t-as="ev" t-key="ev.id">
                <option t-att-value="ev.id" t-att-selected="ev.id === state.selectedEvaluationId" t-esc="evalOptionLabel(ev)"/>
              </t>
            </select>

            <button class="o_kpi_open_eval_btn ms-2" t-on-click="onOpenEvaluationForm">
              <i class="fa fa-file-text-o me-1"/> Open Evaluation
            </button>
          </t>
        </div>
      </div>

      <!-- Loading -->
      <div t-if="state.phase === 'evals' || state.phase === 'dashboard'" class="o_kpi_loading">
        <div class="o_kpi_spinner"/>
        <p>Loading…</p>
      </div>

      <!-- Error -->
      <div t-elif="state.phase === 'error'" class="o_kpi_error_state">
        <i class="fa fa-exclamation-triangle fa-2x"/>
        <p t-esc="state.errorMsg"/>
      </div>

      <!-- Empty state -->
      <div t-elif="!state.data" class="o_kpi_empty_state">
        <i class="fa fa-bar-chart fa-3x"/>
        <p>No performance evaluations found.</p>
      </div>

      <!-- Dashboard body -->
      <div t-else="" class="o_kpi_dashboard">

        <div class="o_kpi_header_cards">

          <div class="o_kpi_summary_card o_kpi_summary_card_profile">
            <p class="o_kpi_dates">
              <i class="fa fa-calendar me-1"/>
              <t t-esc="state.data.start_date"/>
              →
              <t t-esc="state.data.end_date"/>
              <span class="o_kpi_period_badge ms-2" t-esc="periodLabel(state.data.period_type)"/>
            </p>
            <h2 class="o_kpi_title">
              <t t-esc="state.data.employee_name"/>
              <span t-att-class="levelClass" t-esc="levelLabel"/>
            </h2>
            <div class="o_kpi_profile_result_meta">
              <span class="o_kpi_profile_result_label" t-esc="resultScoreLabel"/>
              <span class="o_kpi_profile_result_value" t-esc="resultScoreText"/>
            </div>

          </div>

          <div class="o_kpi_summary_card o_kpi_summary_card_input">
            <div class="o_kpi_summary_label" t-esc="p21Label"/>
            <div class="o_kpi_summary_score">
              <span t-esc="p21ScoreText"/>
            </div>
          </div>

          <div class="o_kpi_summary_card o_kpi_summary_card_input">
            <div class="o_kpi_summary_label" t-esc="p22Label"/>
            <div class="o_kpi_summary_score">
              <span t-esc="p22ScoreText"/>
            </div>
          </div>

          <div class="o_kpi_summary_card o_kpi_summary_card_input">
            <div class="o_kpi_summary_label" t-esc="p3IndividualLabel"/>
            <div class="o_kpi_summary_score">
              <span t-esc="scoreText"/>
            </div>
          </div>

          <div class="o_kpi_summary_card o_kpi_summary_card_input" t-att-title="deptTooltip">
            <div class="o_kpi_summary_label" t-esc="p3DepartmentLabel"/>
            <div t-att-class="'o_kpi_summary_score ' + (state.data.has_dept_evaluation ? '' : 'o_kpi_summary_score_na')">
              <span t-esc="deptScoreText"/>
            </div>
          </div>

        </div>

<t t-if="orderedCharts.length">
        <div class="o_kpi_row o_kpi_dynamic_grid">
          <t t-foreach="orderedCharts" t-as="chart" t-key="chart.key || chart.widget_id || chart_index">
            
<t t-set="card_weight_class" t-value="
                (chart.chart_type === 'doughnut' || chart.chart_type === 'pie') ? 'o_kpi_card_compact' :
                'o_kpi_card_wide'
            "/>
            
            <div t-attf-class="o_kpi_card o_kpi_chart_card {{ card_weight_class }}" t-att-data-chart-type="chart.chart_type || 'bar'">
              <div class="o_kpi_card_header">
                <span class="o_kpi_card_title">
                    <i t-attf-class="fa me-2 {{ chart.chart_type === 'doughnut' ? 'fa-pie-chart text-warning' : (chart.chart_type === 'radar' ? 'fa-bullseye text-danger' : 'fa-bar-chart text-primary') }}"/>
                    <t t-esc="chart.title or chart.chart_meta?.title or 'Chart'"/>
                </span>
              </div>
              
              <div t-attf-class="o_kpi_chart_container {{ chart.chart_type === 'radar' ? 'o_kpi_chart_container_large' : '' }}">
                <canvas t-att-data-chart-key="chart.key || (chart.widget_id ? 'chart_widget_' + chart.widget_id : 'chart_' + chart_index)"></canvas>
                <div t-if="chart.chart_type === 'doughnut' and chart.chart_meta and chart.chart_meta.center_value" class="o_kpi_doughnut_center">
                  <div class="o_kpi_doughnut_val" t-esc="chart.chart_meta.center_value"/>
                  <div class="o_kpi_doughnut_lbl" t-esc="chart.chart_meta.center_label"/>
                </div>
              </div>
              
              <div t-if="chart.chart_meta?.note" class="o_kpi_chart_note text-muted text-center mt-2" style="font-size: 0.85em;">
                <t t-esc="chart.chart_meta.note"/>
              </div>
            </div>

          </t>
        </div>
      </t>

        <!-- Row 3: Quantitative Table -->
        <div  class="o_kpi_row" style="margin-top: 20px;">
          <div class="o_kpi_card o_kpi_table_card o_kpi_card_full">
            <div class="o_kpi_card_header">
              <span class="o_kpi_card_title"> <i class="fa fa-table"/> P3.1.1 Individual KPI</span>
            </div>
            <div class="o_kpi_table_wrapper">
              <table class="o_kpi_table" t-if="state.data.quantitative_table.length">
                <thead>
                  <tr>
                    <th>KPI Measure</th>
                    <th>Unit Measure</th>
                    <th>Target</th>
                    <th>Actual</th>
                    <th>Score</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-foreach="state.data.quantitative_table" t-as="row" t-key="row_index">
                    <tr>
                      <td class="o_kpi_table_name" t-esc="row.name"/>
                      <td t-esc="row.unit_measure"/>
                      <td t-esc="row.target"/>
                      <td t-esc="row.actual"/>
                      <td>
                        <b t-esc="formatScore(row.final_score, 2)"/>
                      </td>
                    </tr>
                  </t>
                </tbody>
              </table>
              <p t-else="" class="o_kpi_empty">No quantitative KPI data available.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </t>

</templates>
