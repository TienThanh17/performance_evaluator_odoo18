#. module: custom_adecsol_hr_performance_evaluator
#: model_terms:ir.ui.view,arch_db:custom_adecsol_hr_performance_evaluator.view_hr_kpi_form
msgid ""
"<strong>- Manual KPI</strong><br/> Binary:\n"
"                                            Pass = 100 points, Fail = 0 points.<br/> Rating: 0 to 5\n"
"                                            stars, each star = 20 points.<br/> Score: enter the\n"
"                                            score directly into the score field.<br/>\n"
"                        <br/>\n"
"                        <strong>-\n"
"                                            Auto KPI</strong><br/> Score is calculated from <strong>\n"
"                                            Target</strong> and <strong>\n"
"                                                            Actual</strong> based on the selected <strong>Scoring\n"
"                                            Formula</strong>. If a data source is linked, the system\n"
"                                            can auto-fill <strong>Actual</strong> before applying\n"
"                                            the formula."
msgstr ""
"<strong>- KPI thủ công</strong><br/> Đạt / Không đạt: Đạt\n"
"                                        = 100 điểm, Không đạt = 0 điểm.<br/> Đánh giá sao: 0 đến 5 sao,\n"
"                                        mỗi sao = 20 điểm.<br/> Điểm số: nhập điểm trực tiếp\n"
"                                        vào ô điểm số.<br/>\n"
"                        <br/>\n"
"                        <strong>- KPI tự động</strong><br/>\n"
"                                        Điểm được tính toán từ <strong>Mục tiêu</strong> và <strong>\n"
"                                        Thực tế</strong> dựa trên <strong>Công thức tính\n"
"                                        điểm</strong> được chọn. Nếu có liên kết với nguồn dữ liệu,\n"
"                                        hệ thống có thể tự động điền <strong>Thực tế</strong>\n"
"                                        trước khi áp dụng công thức."

