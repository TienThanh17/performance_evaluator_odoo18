<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="formula_linear_higher" model="hr.kpi.scoring.formula">
            <field name="name">Tuyến tính - Càng cao càng tốt</field>
            <field name="sequence">1</field>
            <field name="formula_type">linear</field>
            <field name="linear_direction">higher_better</field>
            <field name="linear_allow_exceed">False</field>

            <field name="description">actual / target * max_score, tối đa max_score.</field>
        </record>

        <record id="formula_linear_lower" model="hr.kpi.scoring.formula">
            <field name="name">Tuyến tính - Càng thấp càng tốt</field>
            <field name="sequence">2</field>
            <field name="formula_type">linear</field>
            <field name="linear_direction">lower_better</field>
            <field name="linear_allow_exceed">False</field>

            <field name="description">target / actual * max_score, tối đa max_score.</field>
        </record>

        <!-- <record id="formula_linear_higher_bonus" model="hr.kpi.scoring.formula">
            <field name="name">Tuyến tính - Có bonus khi vượt target</field>
            <field name="sequence">3</field>
            <field name="formula_type">linear</field>
            <field name="linear_direction">higher_better</field>
            <field name="linear_allow_exceed">True</field>
            
            <field name="description">actual / target * max_score, không giới hạn trên.</field>
        </record> -->

        <record id="formula_penalty_1pt" model="hr.kpi.scoring.formula">
            <field name="name">Trừ điểm - 10 điểm/đơn vị</field>
            <field name="sequence">10</field>
            <field name="formula_type">penalty</field>
            <field name="penalty_deduct_per_unit">10.0</field>
            <field name="penalty_floor">0.0</field>
            <field name="description">Bắt đầu từ max_score runtime, trừ 1 điểm mỗi đơn vị vi phạm.</field>
        </record>

        <record id="formula_penalty_2pt" model="hr.kpi.scoring.formula">
            <field name="name">Trừ điểm - 20 điểm/đơn vị</field>
            <field name="sequence">11</field>
            <field name="formula_type">penalty</field>
            <field name="penalty_deduct_per_unit">20.0</field>
            <field name="penalty_floor">0.0</field>
            <field name="description">Bắt đầu từ max_score runtime, trừ 2 điểm mỗi đơn vị vi phạm.</field>
        </record>

        <record id="formula_step_table_target_gate" model="hr.kpi.scoring.formula">
            <field name="name">Bảng bậc thang</field>
            <field name="sequence">21</field>
            <field name="formula_type">step_table</field>
            <field name="step_out_of_range">nearest</field>
            <field name="step_table_json"><![CDATA[
[
  {"from": 0, "to": 50, "score": 0},
  {"from": 51, "to": 70, "score": 60},
  {"from": 71, "to": 90, "score": 80},
  {"from": 91, "to": 100, "score": 100}
]
            ]]></field>

            <field name="description">Mẫu phù hợp KPI có ngưỡng rõ ràng: chỉ khi chạm target mới đạt
                điểm tối đa.</field>
        </record>

        <!-- apply to demo -->
        <record id="formula_step_target_0_kem_1" model="hr.kpi.scoring.formula">
            <field name="name">Bậc thang: Mục tiêu 0 - Kém 1</field>
            <field name="sequence">101</field>
            <field name="formula_type">step_table</field>
            <field name="step_out_of_range">nearest</field>
            <field name="step_table_json"><![CDATA[
[
  {"from": 0, "to": 0, "score": 100},
  {"from": 1, "to": 999, "score": 0}
]
            ]]></field>
            <field name="description">Áp dụng cho các chỉ tiêu vi phạm nghiêm trọng: 0 vi phạm
                đạt 100đ, từ 1 vi phạm trở lên về 0đ.</field>
        </record>

        <record id="formula_step_target_3_kem_1" model="hr.kpi.scoring.formula">
            <field name="name">Bậc thang: Mục tiêu 3 - Kém 1</field>
            <field name="sequence">102</field>
            <field name="formula_type">step_table</field>
            <field name="step_out_of_range">nearest</field>
            <field name="step_table_json"><![CDATA[
[
  {"from": 0, "to": 1, "score": 0},
  {"from": 2, "to": 2, "score": 50},
  {"from": 3, "to": 999, "score": 100}
]
            ]]></field>
            <field name="description">Áp dụng cho chỉ tiêu Đề xuất phương án thực hiện (Gia tăng
                hiệu suất).</field>
        </record>

        <record id="formula_step_target_1_kem_0" model="hr.kpi.scoring.formula">
            <field name="name">Bậc thang: Mục tiêu 1 - Kém 0</field>
            <field name="sequence">103</field>
            <field name="formula_type">step_table</field>
            <field name="step_out_of_range">nearest</field>
            <field name="step_table_json"><![CDATA[
[
  {"from": 0, "to": 0, "score": 0},
  {"from": 1, "to": 999, "score": 100}
]
            ]]></field>
            <field name="description">Áp dụng cho phong trào Kaizen/Cải tiến: Không thực hiện
                0đ, có đóng góp đạt 100đ.</field>
        </record>

        <record id="formula_step_variance_target_1_kem_2" model="hr.kpi.scoring.formula">
            <field name="name">Bậc thang: Sai lệch Mục tiêu 1% - Kém 2%</field>
            <field name="sequence">104</field>
            <field name="formula_type">step_table</field>
            <field name="step_out_of_range">nearest</field>
            <field name="step_table_json"><![CDATA[
[
  {"from": 0, "to": 1, "score": 100},
  {"from": 2, "to": 999, "score": 0}
]
            ]]></field>
            <field name="description">Áp dụng cho chỉ tiêu tài chính/đo đạc thực tế (Tính theo
                giá trị phần trăm đầu vào nguyên).</field>
        </record>

        <record id="formula_step_rate_target_80" model="hr.kpi.scoring.formula">
            <field name="name">Bậc thang: Tỷ lệ đạt Mục tiêu &gt;80% - Kém &lt;80%</field>
            <field name="sequence">105</field>
            <field name="formula_type">step_table</field>
            <field name="step_out_of_range">nearest</field>
            <field name="step_table_json"><![CDATA[
[
  {"from": 0, "to": 79, "score": 0},
  {"from": 80, "to": 100, "score": 100}
]
            ]]></field>
            <field name="description">Áp dụng cho các chỉ tiêu đo lường hiệu suất hoặc tỷ lệ hài
                lòng theo phần trăm.</field>
        </record>

        <record id="formula_step_target_0_kem_2" model="hr.kpi.scoring.formula">
            <field name="name">Bậc thang: Mục tiêu 0 - Kém 2</field>
            <field name="sequence">106</field>
            <field name="formula_type">step_table</field>
            <field name="step_out_of_range">nearest</field>
            <field name="step_table_json"><![CDATA[
[
  {"from": 0, "to": 0, "score": 100},
  {"from": 1, "to": 1, "score": 50},
  {"from": 2, "to": 999, "score": 0}
]
            ]]></field>
            <field name="description">Áp dụng cho nội quy quy chế: Vi phạm 1 lần giảm 50% điểm,
                vi phạm từ 2 lần trở lên mất sạch điểm.</field>
        </record>

        <record id="formula_step_target_1_kem_2" model="hr.kpi.scoring.formula">
            <field name="name">Bậc thang: Mục tiêu 1 - Kém 2</field>
            <field name="sequence">107</field>
            <field name="formula_type">step_table</field>
            <field name="step_out_of_range">nearest</field>
            <field name="step_table_json"><![CDATA[
[
  {"from": 0, "to": 1, "score": 100},
  {"from": 2, "to": 999, "score": 0}
]
    ]]></field>
            <field name="description">Mục tiêu 1 lần đạt 100đ, từ 2 lần (Kém) trở lên nhận 0đ.</field>
        </record>

        <record id="formula_step_target_5_kem_6" model="hr.kpi.scoring.formula">
            <field name="name">Bậc thang: Mục tiêu 5 - Kém 6</field>
            <field name="sequence">108</field>
            <field name="formula_type">step_table</field>
            <field name="step_out_of_range">nearest</field>
            <field name="step_table_json"><![CDATA[
[
  {"from": 0, "to": 5, "score": 100},
  {"from": 6, "to": 999, "score": 0}
]
    ]]></field>
            <field name="description">Đạt từ 5 trở xuống nhận 100đ, từ 6 (Kém) trở lên nhận 0đ.</field>
        </record>

        <record id="formula_step_target_2_kem_3" model="hr.kpi.scoring.formula">
            <field name="name">Bậc thang: Mục tiêu 2 - Kém 3</field>
            <field name="sequence">109</field>
            <field name="formula_type">step_table</field>
            <field name="step_out_of_range">nearest</field>
            <field name="step_table_json"><![CDATA[
[
  {"from": 0, "to": 2, "score": 100},
  {"from": 3, "to": 999, "score": 0}
]
    ]]></field>
            <field name="description">Mục tiêu từ 2 trở xuống đạt 100đ, từ 3 (Kém) trở lên nhận 0đ.</field>
        </record>

        <record id="formula_step_target_3_kem_4" model="hr.kpi.scoring.formula">
            <field name="name">Bậc thang: Mục tiêu 3 - Kém 4</field>
            <field name="sequence">110</field>
            <field name="formula_type">step_table</field>
            <field name="step_out_of_range">nearest</field>
            <field name="step_table_json"><![CDATA[
[
  {"from": 0, "to": 3, "score": 100},
  {"from": 4, "to": 999, "score": 0}
]
    ]]></field>
            <field name="description">Mục tiêu từ 3 trở xuống đạt 100đ, từ 4 (Kém) trở lên nhận 0đ.</field>
        </record>

        <record id="formula_step_rate_target_80_kem_60" model="hr.kpi.scoring.formula">
            <field name="name">Bậc thang: Tỷ lệ Mục tiêu 80% - Kém 60%</field>
            <field name="sequence">111</field>
            <field name="formula_type">step_table</field>
            <field name="step_out_of_range">nearest</field>
            <field name="step_table_json"><![CDATA[
[
  {"from": 0, "to": 60, "score": 0},
  {"from": 80, "to": 100, "score": 100}
]
    ]]></field>
            <field name="description">Tỷ lệ đạt từ 80% trở lên đạt 100đ, bằng hoặc dưới 60% nhận 0đ.</field>
        </record>

        <record id="formula_step_rate_target_90_kem_70" model="hr.kpi.scoring.formula">
            <field name="name">Bậc thang: Tỷ lệ Mục tiêu 90% - Kém 70%</field>
            <field name="sequence">112</field>
            <field name="formula_type">step_table</field>
            <field name="step_out_of_range">nearest</field>
            <field name="step_table_json"><![CDATA[
[
  {"from": 0, "to": 70, "score": 0},
  {"from": 90, "to": 100, "score": 100}
]
    ]]></field>
            <field name="description">Tỷ lệ đạt từ 90% trở lên đạt 100đ, bằng hoặc dưới 70% nhận 0đ.</field>
        </record>

    </data>
</odoo>