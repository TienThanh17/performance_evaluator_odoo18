        <record id="res_config_setting_kpi_threshold_excellent" model="ir.config_parameter">
            <field name="key">custom_adecsol_hr_performance_evaluator.kpi_threshold_excellent</field>
            <field name="value">90.0</field>
        </record>

        <!-- System Parameter cho ngưỡng Đạt -->
        <record id="res_config_setting_kpi_threshold_pass" model="ir.config_parameter">
            <field name="key">custom_adecsol_hr_performance_evaluator.kpi_threshold_pass</field>
