<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="dept_information_technology" model="hr.department">
            <field name="name">Phòng Công nghệ thông tin</field>
        </record>

        <record id="period_it_2026_05" model="hr.kpi.period">
            <field name="name">Tháng 05/2026</field>
            <field name="period_type">monthly</field>
            <field name="date_start">2026-05-01</field>
            <field name="date_end">2026-05-31</field>
        </record>

        <record id="scoring_profile_it_monthly" model="hr.kpi.scoring.profile">
            <field name="name">IT Monthly Profile</field>
            <field name="threshold_excellent">8.5</field>
            <field name="threshold_pass">6.0</field>
        </record>

        <record id="department_kpi_it_2026_05" model="hr.department.kpi.template">
            <field name="name">KPI Phòng ban IT - Tháng 05/2026</field>
            <field name="department_id" ref="custom_adecsol_hr_performance_evaluator.dept_information_technology"/>
            <field name="period_id" ref="custom_adecsol_hr_performance_evaluator.period_it_2026_05"/>
            <field name="scoring_profile_id" ref="custom_adecsol_hr_performance_evaluator.scoring_profile_it_monthly"/>
            <field name="dept_weight">0.4</field>
            <field name="individual_weight">0.6</field>
        </record>

        <record id="department_kpi_it_delivery_score" model="hr.department.kpi.template.line">
            <field name="department_kpi_id" ref="custom_adecsol_hr_performance_evaluator.department_kpi_it_2026_05"/>
            <field name="name">Điểm giao việc đúng hạn</field>
            <field name="kpi_type">auto</field>
            <field name="dept_source_type">child_kpi_average</field>
            <field name="unit" ref="custom_adecsol_hr_performance_evaluator.kpi_unit_score"/>
            <field name="target">10</field>
            <field name="scoring_formula_id" ref="custom_adecsol_hr_performance_evaluator.formula_linear_higher"/>
            <field name="weight">45</field>
            <field name="sequence">20</field>
        </record>

        <record id="department_kpi_it_attendance_score" model="hr.department.kpi.template.line">
            <field name="department_kpi_id" ref="custom_adecsol_hr_performance_evaluator.department_kpi_it_2026_05"/>
            <field name="name">Điểm chấm công và đúng giờ</field>
            <field name="kpi_type">auto</field>
            <field name="dept_source_type">child_kpi_average</field>
            <field name="unit" ref="custom_adecsol_hr_performance_evaluator.kpi_unit_score"/>
            <field name="target">10</field>
            <field name="scoring_formula_id" ref="custom_adecsol_hr_performance_evaluator.formula_linear_higher"/>
            <field name="weight">35</field>
            <field name="sequence">40</field>
        </record>

        <record id="department_kpi_it_quality_score" model="hr.department.kpi.template.line">
            <field name="department_kpi_id" ref="custom_adecsol_hr_performance_evaluator.department_kpi_it_2026_05"/>
            <field name="name">Điểm chất lượng và ý thức</field>
            <field name="kpi_type">auto</field>
            <field name="dept_source_type">child_kpi_average</field>
            <field name="unit" ref="custom_adecsol_hr_performance_evaluator.kpi_unit_score"/>
            <field name="target">10</field>
            <field name="scoring_formula_id" ref="custom_adecsol_hr_performance_evaluator.formula_linear_higher"/>
            <field name="weight">20</field>
            <field name="sequence">60</field>
        </record>

        <record id="employee_kpi_it_2026_05" model="hr.kpi.template">
            <field name="name">KPI Nhân viên IT - Tháng 05/2026</field>
            <field name="department_id" ref="custom_adecsol_hr_performance_evaluator.dept_information_technology"/>
            <field name="period_id" ref="custom_adecsol_hr_performance_evaluator.period_it_2026_05"/>
            <field name="scoring_profile_id" ref="custom_adecsol_hr_performance_evaluator.scoring_profile_it_monthly"/>
            <field name="department_kpi_id" ref="custom_adecsol_hr_performance_evaluator.department_kpi_it_2026_05"/>
        </record>

        <record id="employee_kpi_it_section_delivery" model="hr.kpi.template.line">
            <field name="kpi_id" ref="custom_adecsol_hr_performance_evaluator.employee_kpi_it_2026_05"/>
            <field name="key_performance_area">Định lượng</field>
            <field name="is_section">True</field>
            <field name="sequence">10</field>
        </record>

        <record id="employee_kpi_it_done_tasks" model="hr.kpi.template.line">
            <field name="kpi_id" ref="custom_adecsol_hr_performance_evaluator.employee_kpi_it_2026_05"/>
            <field name="key_performance_area">Số task hoàn thành</field>
            <field name="kpi_type">auto</field>
            <field name="target">20</field>
            <field name="unit" ref="custom_adecsol_hr_performance_evaluator.kpi_unit_task"/>
            <field name="weight">25</field>
            <field name="data_source_id" ref="custom_adecsol_hr_performance_evaluator.source_task_done_count"/>
            <field name="scoring_formula_id" ref="custom_adecsol_hr_performance_evaluator.formula_linear_higher_bonus"/>
            <field name="parent_dept_line_id" ref="custom_adecsol_hr_performance_evaluator.department_kpi_it_delivery_score"/>
            <field name="sequence">20</field>
        </record>

        <record id="employee_kpi_it_on_time_rate" model="hr.kpi.template.line">
            <field name="kpi_id" ref="custom_adecsol_hr_performance_evaluator.employee_kpi_it_2026_05"/>
            <field name="key_performance_area">Tỷ lệ task đúng hạn</field>
            <field name="kpi_type">auto</field>
            <field name="target">90</field>
            <field name="unit" ref="custom_adecsol_hr_performance_evaluator.kpi_unit_percent"/>
            <field name="weight">20</field>
            <field name="data_source_id" ref="custom_adecsol_hr_performance_evaluator.source_task_on_time_rate"/>
            <field name="scoring_formula_id" ref="custom_adecsol_hr_performance_evaluator.formula_step_table_target_gate"/>
            <field name="parent_dept_line_id" ref="custom_adecsol_hr_performance_evaluator.department_kpi_it_delivery_score"/>
            <field name="sequence">30</field>
        </record>

        <record id="employee_kpi_it_present_days" model="hr.kpi.template.line">
            <field name="kpi_id" ref="custom_adecsol_hr_performance_evaluator.employee_kpi_it_2026_05"/>
            <field name="key_performance_area">Đi làm đầy đủ</field>
            <field name="kpi_type">auto</field>
            <field name="target">22</field>
            <field name="unit" ref="custom_adecsol_hr_performance_evaluator.kpi_unit_day"/>
            <field name="weight">20</field>
            <field name="data_source_id" ref="custom_adecsol_hr_performance_evaluator.source_attendance_present_days"/>
            <field name="scoring_formula_id" ref="custom_adecsol_hr_performance_evaluator.formula_linear_higher"/>
            <field name="parent_dept_line_id" ref="custom_adecsol_hr_performance_evaluator.department_kpi_it_attendance_score"/>
            <field name="sequence">50</field>
        </record>

        <record id="employee_kpi_it_late_days" model="hr.kpi.template.line">
            <field name="kpi_id" ref="custom_adecsol_hr_performance_evaluator.employee_kpi_it_2026_05"/>
            <field name="key_performance_area">Số ngày đi muộn</field>
            <field name="kpi_type">auto</field>
            <field name="target">0</field>
            <field name="unit" ref="custom_adecsol_hr_performance_evaluator.kpi_unit_day"/>
            <field name="weight">15</field>
            <field name="data_source_id" ref="custom_adecsol_hr_performance_evaluator.source_attendance_late_days"/>
            <field name="scoring_formula_id" ref="custom_adecsol_hr_performance_evaluator.formula_penalty_1pt"/>
            <field name="parent_dept_line_id" ref="custom_adecsol_hr_performance_evaluator.department_kpi_it_attendance_score"/>
            <field name="sequence">70</field>
        </record>

        <record id="employee_kpi_it_section_quality" model="hr.kpi.template.line">
            <field name="kpi_id" ref="custom_adecsol_hr_performance_evaluator.employee_kpi_it_2026_05"/>
            <field name="key_performance_area">Định tính</field>
            <field name="is_section">True</field>
            <field name="sequence">80</field>
        </record>

        <record id="employee_kpi_it_skill" model="hr.kpi.template.line">
            <field name="kpi_id" ref="custom_adecsol_hr_performance_evaluator.employee_kpi_it_2026_05"/>
            <field name="parent_dept_line_id" ref="custom_adecsol_hr_performance_evaluator.department_kpi_it_quality_score"/>
            <field name="key_performance_area">Tay nghề &amp; Kỹ năng lập trình Odoo</field>
            <field name="description" type="html">
                <ul>
                    <li>
                        <strong>5 sao (10đ):</strong> Xuất sắc - Tự giải quyết task khó, tối ưu
                        performance. </li>
                    <li>
                        <strong>4 sao (8đ):</strong> Tốt - Hoàn thành đúng quy trình, code sạch, ít
                        lỗi. </li>
                    <li>
                        <strong>3 sao (6đ):</strong> Khá - Đáp ứng cơ bản, đôi khi cần hỗ trợ nhẹ. </li>
                    <li>
                        <strong>2 sao (4đ):</strong> Trung bình - Còn thiếu sót, cần giám sát chặt
                        chẽ. </li>
                    <li>
                        <strong>1 sao (2đ):</strong> Yếu - Không hoàn thành, kỹ năng code kém. </li>
                </ul>
            </field>
            <field name="kpi_type">manual</field>
            <field name="manual_scoring_type">rating</field>
            <field name="weight">6.0</field>
            <field name="sequence">90</field>
        </record>

        <record id="employee_kpi_it_quality" model="hr.kpi.template.line">
            <field name="kpi_id" ref="custom_adecsol_hr_performance_evaluator.employee_kpi_it_2026_05"/>
            <field name="parent_dept_line_id" ref="custom_adecsol_hr_performance_evaluator.department_kpi_it_quality_score"/>
            <field name="key_performance_area">Chất lượng Code &amp; Tuân thủ Quy trình</field>
            <field name="description" type="html">
                <ul>
                    <li>
                        <strong>5 sao (10đ):</strong> Tuyệt đối tuân thủ coding convention, không có
                        bug logic. </li>
                    <li>
                        <strong>4 sao (8đ):</strong> Tuân thủ quy trình, lỗi nhẹ không đáng kể. </li>
                    <li>
                        <strong>3 sao (6đ):</strong> Có lỗi convention hoặc logic nhẹ cần fix lại. </li>
                    <li>
                        <strong>2 sao (4đ):</strong> Thường xuyên phải rework do không đọc kỹ yêu
                        cầu. </li>
                    <li>
                        <strong>1 sao (2đ):</strong> Vi phạm nghiêm trọng quy trình phát triển. </li>
                </ul>
            </field>
            <field name="kpi_type">manual</field>
            <field name="manual_scoring_type">rating</field>
            <field name="weight">4.0</field>
            <field name="sequence">100</field>
        </record>

        <record id="employee_kpi_it_teamwork" model="hr.kpi.template.line">
            <field name="kpi_id" ref="custom_adecsol_hr_performance_evaluator.employee_kpi_it_2026_05"/>
            <field name="parent_dept_line_id" ref="custom_adecsol_hr_performance_evaluator.department_kpi_it_quality_score"/>
            <field name="key_performance_area">Làm việc nhóm &amp; Hỗ trợ đồng nghiệp</field>
            <field name="description" type="html">
                <ul>
                    <li>
                        <strong>5 sao (10đ):</strong> Chủ động hỗ trợ, review code và chia sẻ kiến
                        thức. </li>
                    <li>
                        <strong>4 sao (8đ):</strong> Phối hợp tốt, phản hồi nhanh các yêu cầu hỗ
                        trợ. </li>
                    <li>
                        <strong>3 sao (6đ):</strong> Hoàn thành phần việc cá nhân, phối hợp ở mức
                        vừa đủ. </li>
                    <li>
                        <strong>2 sao (4đ):</strong> Ít tương tác, phản hồi chậm gây ảnh hưởng tiến
                        độ chung. </li>
                    <li>
                        <strong>1 sao (2đ):</strong> Thiếu tinh thần hợp tác, gây mất đoàn kết. </li>
                </ul>
            </field>
            <field name="kpi_type">manual</field>
            <field name="manual_scoring_type">rating</field>
            <field name="weight">4.0</field>
            <field name="sequence">110</field>
        </record>

        <record id="employee_kpi_it_asset" model="hr.kpi.template.line">
            <field name="kpi_id" ref="custom_adecsol_hr_performance_evaluator.employee_kpi_it_2026_05"/>
            <field name="parent_dept_line_id" ref="custom_adecsol_hr_performance_evaluator.department_kpi_it_quality_score"/>
            <field name="key_performance_area">Ý thức bảo vệ tài sản &amp; Tiết kiệm</field>
            <field name="description" type="html">
                <ul>
                    <li>
                        <strong>5 sao (10đ):</strong> Giữ gìn máy móc, bảo mật dữ liệu tuyệt đối,
                        tiết kiệm điện nước. </li>
                    <li>
                        <strong>4 sao (8đ):</strong> Có ý thức tốt trong việc sử dụng tài sản công
                        ty. </li>
                    <li>
                        <strong>3 sao (6đ):</strong> Đôi khi còn lãng phí văn phòng phẩm hoặc quên
                        tắt thiết bị. </li>
                    <li>
                        <strong>2 sao (4đ):</strong> Sử dụng thiết bị cẩu thả, không tuân thủ quy
                        định bảo mật. </li>
                    <li>
                        <strong>1 sao (2đ):</strong> Gây hư hỏng hoặc làm mất mát tài sản do thiếu
                        trách nhiệm. </li>
                </ul>
            </field>
            <field name="kpi_type">manual</field>
            <field name="manual_scoring_type">rating</field>
            <field name="weight">3.0</field>
            <field name="sequence">120</field>
        </record>

        <record id="employee_kpi_it_discipline" model="hr.kpi.template.line">
            <field name="kpi_id" ref="custom_adecsol_hr_performance_evaluator.employee_kpi_it_2026_05"/>
            <field name="parent_dept_line_id" ref="custom_adecsol_hr_performance_evaluator.department_kpi_it_quality_score"/>
            <field name="key_performance_area">Chấp hành nội quy</field>
            <field name="description" type="html">
                <ul>
                    <li>
                        <strong>5 sao (10đ):</strong> Không vi phạm bất kỳ nội quy nào. </li>
                    <li>
                        <strong>4 sao (8đ):</strong> Vi phạm tối đa 1 lần lỗi nhẹ trong tháng. </li>
                    <li>
                        <strong>3 sao (6đ):</strong> Vi phạm 2-3 lần lỗi nhẹ. </li>
                    <li>
                        <strong>2 sao (4đ):</strong> Vi phạm thường xuyên (trên 4 lần). </li>
                    <li>
                        <strong>1 sao (2đ):</strong> Vi phạm nghiêm trọng quy định của công ty. </li>
                </ul>
            </field>
            <field name="kpi_type">manual</field>
            <field name="manual_scoring_type">rating</field>
            <field name="weight">3.0</field>
            <field name="sequence">130</field>
        </record>
    </data>
</odoo>
