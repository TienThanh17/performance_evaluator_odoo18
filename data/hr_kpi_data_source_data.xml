<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="source_task_done_count" model="hr.kpi.data.source">
            <field name="name">Số task hoàn thành</field>
            <field name="code">task_done_count</field>
            <field name="unit_id" ref="custom_adecsol_hr_performance_evaluator.kpi_unit_task" />
            <field name="source_type">domain</field>
            <field name="dashboard_enabled">True</field>
            <field name="dashboard_provider_key">generic_domain_daily_series</field>
            <field name="dashboard_chart_type">line</field>
            <field name="description">Đếm số task đã hoàn thành trong kỳ theo người được giao.</field>
            <field name="model_id" search="[('model', '=', 'project.task')]" />
            <field name="aggregation">count</field>
            <field name="user_field_id"
                search="[('model', '=', 'project.task'), ('name', '=', 'user_ids')]" />
            <field name="domain_numerator">[('done_date', '!=', False), ('project_id', '!=', False)]</field>
            <field name="date_field_id"
                search="[('model', '=', 'project.task'), ('name', '=', 'date_deadline')]" />
        </record>

        <record id="source_task_on_time_rate" model="hr.kpi.data.source">
            <field name="name">Tỷ lệ task đúng hạn</field>
            <field name="code">task_on_time_rate</field>
            <field name="unit_id" ref="custom_adecsol_hr_performance_evaluator.kpi_unit_percent" />
            <field name="source_type">domain</field>
            <field name="dashboard_enabled">False</field>
            <field name="dashboard_provider_key" eval="False" />
            <field name="dashboard_chart_type" eval="False" />
            <field name="description">Tính tỷ lệ task hoàn thành đúng hạn trong kỳ.</field>
            <field name="model_id" search="[('model', '=', 'project.task')]" />
            <field name="aggregation">ratio</field>
            <field name="user_field_id"
                search="[('model', '=', 'project.task'), ('name', '=', 'user_ids')]" />
            <field name="domain_numerator">[('done_date', '!=', False), ('project_id', '!=', False)]</field>
            <field name="domain_denominator">[('project_id', '!=', False)]</field>
            <field name="date_field_id"
                search="[('model', '=', 'project.task'), ('name', '=', 'date_deadline')]" />
        </record>

        <record id="source_attendance_present_days" model="hr.kpi.data.source">
            <field name="name">Số ngày đi làm thực tế</field>
            <field name="code">attendance_present_days</field>
            <field name="unit_id" ref="custom_adecsol_hr_performance_evaluator.kpi_unit_day" />

            <field name="source_type">system</field>

            <field name="dashboard_enabled">True</field>
            <field name="dashboard_provider_key">special_engine_attendance_overview</field>
            <field name="dashboard_chart_type">doughnut</field>
            <field name="description">Đếm số ngày làm việc có check-in hợp lệ (Được quản lý bởi hệ
                thống).</field>
        </record>

        <!-- <record id="source_attendance_on_time_days" model="hr.kpi.data.source">
