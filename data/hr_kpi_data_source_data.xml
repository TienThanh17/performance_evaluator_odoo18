        <record id="source_attendance_late_days" model="hr.kpi.data.source">
            <field name="name">Số ngày đi muộn</field>
            <field name="code">attendance_late_days</field>
            <field name="unit_id" ref="custom_adecsol_hr_performance_evaluator.kpi_unit_day" />

            <field name="source_type">system</field>

            <field name="dashboard_enabled">True</field>
            <field name="dashboard_provider_key">special_engine_punctuality</field>
            <field name="dashboard_chart_type">line</field>
            <field name="description">Đếm số ngày nhân viên đi muộn trong kỳ theo lịch làm việc và
                grace minutes (Hệ thống tự động tính).</field>
        </record>
    </data>
</odoo>